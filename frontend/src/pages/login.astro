---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Iniciar sesión" active="login" navRole="anonimo">
  <div class="py-6 md:py-10 flex justify-center">
    <div class="w-full max-w-[460px] flex flex-col gap-6">

      <!-- Acceso Rápido PC Laboratorio (QR inverso) -->
      <a
        href="/pair/"
        class="card bg-base-100 border-2 border-primary hover:border-primary/80 shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 p-4 flex flex-row items-center gap-3.5 text-base-content no-underline"
      >
        <div class="size-11 rounded-xl bg-primary/10 text-primary grid place-items-center shrink-0">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
            <line x1="17" y1="7" x2="17.01" y2="7"></line>
            <line x1="7" y1="17" x2="7.01" y2="17"></line>
            <line x1="17" y1="17" x2="17.01" y2="17"></line>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-primary leading-tight">¿Estás en la PC del colegio?</span>
            <span class="badge badge-primary badge-xs font-mono font-bold uppercase tracking-wider text-[10px] px-1.5 py-0.5">Rápido</span>
          </div>
          <p class="text-xs text-base-content/70 mt-0.5 leading-snug">
            Iniciá sesión escaneando un código QR con tu celular. Sin contraseñas.
          </p>
        </div>
        <span class="text-primary font-bold text-lg shrink-0">→</span>
      </a>

      <!-- Bienvenida / Título -->
      <div class="text-center">
        <h1 class="font-display font-normal text-3xl sm:text-4xl tracking-tight text-base-content">
          Ingresá a tu aula
        </h1>
        <p class="mt-1.5 text-sm text-base-content/70">
          Escribí tu email institucional para ingresar a tu espacio.
        </p>
      </div>

      <!-- Auth Card Unificada -->
      <div class="card bg-base-100 border border-base-300 shadow-sm p-6 sm:p-7">

        <!-- PASO 1: Ingreso de Email Único -->
        <form id="form-email-step" novalidate class="flex flex-col gap-3">
          <div class="form-control flex flex-col gap-1.5">
            <label for="input-email" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Email educativo
            </label>
            <input
              id="input-email"
              type="email"
              autocomplete="email"
              placeholder="vos@escuela.edu.ar"
              required
              autofocus
              class="input input-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary text-base"
            />
          </div>

          <p class="text-xs text-base-content/60 leading-relaxed -mt-1 mb-1">
            Alumnos ingresan sin contraseña por magic link. Docentes y directivos con su clave.
          </p>

          <button class="btn btn-primary rounded-xl w-full font-semibold" type="submit" id="btn-continuar-email">
            Continuar
          </button>
        </form>

        <!-- PASO 2A: Docente / Directivo (Paso Password) -->
        <form id="form-password-step" hidden novalidate class="flex flex-col gap-3.5">
          <div class="badge badge-warning badge-soft font-semibold text-xs py-2.5 px-3 rounded-lg flex items-center gap-1.5 self-start">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Cuenta Docente / Directivo detectada
          </div>

          <div class="form-control flex flex-col gap-1.5">
            <label for="docente-email-display" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Email
            </label>
            <input
              id="docente-email-display"
              type="email"
              readonly
              class="input input-bordered w-full rounded-xl bg-base-200/50 opacity-80 cursor-not-allowed text-sm font-mono"
            />
          </div>

          <div class="form-control flex flex-col gap-1.5">
            <div class="flex justify-between items-center">
              <label for="input-password" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
                Contraseña
              </label>
              <button type="button" id="link-olvido-pass" class="btn btn-link btn-xs text-xs text-base-content/60 hover:text-primary no-underline p-0 h-auto">
                ¿Olvidaste tu clave?
              </button>
            </div>
            <div class="relative flex items-center">
              <input
                id="input-password"
                type="password"
                autocomplete="current-password"
                placeholder="Tu contraseña"
                required
                class="input input-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary pr-11 text-base"
              />
              <button
                type="button"
                id="btn-toggle-pass"
                class="btn btn-ghost btn-sm btn-circle absolute right-1 text-base-content/50 hover:text-base-content"
                aria-label="Mostrar u ocultar contraseña"
              >
                <svg id="icon-eye" class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <button class="btn btn-primary rounded-xl w-full font-semibold mt-1" type="submit" id="btn-ingresar-docente">
            Iniciar sesión
          </button>

          <div class="flex justify-center mt-1">
            <button class="btn btn-ghost btn-xs text-xs text-base-content/70 hover:text-base-content underline" type="button" id="btn-volver-email">
              Usar otro email
            </button>
          </div>
        </form>

        <!-- PASO 2B: Alumno (Magic link enviado) -->
        <div class="text-center py-2 flex flex-col items-center gap-3" id="estado-magic-enviado" hidden role="status">
          <div class="badge badge-success badge-soft font-semibold text-xs py-2.5 px-3 rounded-lg flex items-center gap-1.5 mb-1">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
            Cuenta de Alumno · Sin contraseña
          </div>

          <span class="size-14 rounded-full bg-primary text-primary-content grid place-items-center shadow-md">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </span>

          <h2 class="font-display font-normal text-2xl sm:text-3xl tracking-tight text-base-content">
            ¡Te enviamos tu link de acceso!
          </h2>

          <p class="text-sm text-base-content/80">
            Revisá tu correo en <b class="badge badge-neutral font-mono text-xs px-2 py-1" id="alumno-mail-enviado">vos@alumnos.edu.ar</b>
          </p>

          <p class="text-xs text-base-content/60 max-w-xs leading-relaxed">
            Tocá el enlace del mensaje para entrar directamente a tu aula o emparejar la app en tu celular.
          </p>

          <div class="flex gap-3 mt-2">
            <button class="btn btn-ghost btn-sm text-primary underline font-medium" type="button" id="btn-reenviar-magic">
              Reenviar link
            </button>
            <button class="btn btn-ghost btn-sm text-base-content/60 hover:text-base-content" type="button" id="btn-cambiar-email-magic">
              Usar otro email
            </button>
          </div>
        </div>

        <!-- Info box de registro cerrado -->
        <div class="mt-5 p-3.5 bg-base-200 border border-base-300 rounded-xl text-xs text-base-content/80 flex items-start gap-2.5">
          <svg class="size-4.5 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <div class="leading-relaxed">
            <strong class="font-bold text-base-content">Registro cerrado:</strong> Las cuentas de alumnos y docentes son creadas por la escuela. Si no tenés usuario, pedile a tu docente que te sume a su aula.
          </div>
        </div>

      </div>

      <!-- Bloque de Ingreso por Código (Escuela o Aula) -->
      <div class="card bg-base-100 border-2 border-dashed border-base-300 p-5 sm:p-6 text-center gap-3">
        <h2 class="font-display font-normal text-2xl tracking-tight text-base-content">
          ¿Tenés código de escuela o aula?
        </h2>
        <p class="text-xs text-base-content/70">
          Entrá como visitante para explorar materiales públicos o sumarte a tu aula.
        </p>

        <div class="flex gap-2 mt-1">
          <input
            class="input input-bordered flex-1 rounded-xl text-center font-mono font-bold text-lg tracking-widest uppercase bg-base-200/60 focus:bg-base-100 focus:border-primary"
            id="input-codigo"
            type="text"
            maxlength="8"
            placeholder="ET1-BA"
            autocomplete="off"
            spellcheck="false"
            aria-label="Código de la escuela o aula"
          />
          <button class="btn btn-outline btn-primary rounded-xl px-5 font-semibold shrink-0" type="button" id="btn-ingresar-codigo">
            Ingresar
          </button>
        </div>
        <p class="text-[11px] text-base-content/60">
          Ejemplo: código de escuela para ver proyectos o código de curso para vincular tu cuenta.
        </p>
      </div>

      <!-- Barra de pruebas rápidas (para testing y evaluación de UX) -->
      <div class="card bg-base-100/60 border border-base-300 p-3.5 text-center gap-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-base-content/60">
          🧪 Probar flujos en esta demo:
        </div>
        <div class="flex justify-center gap-1.5 flex-wrap">
          <button type="button" class="btn btn-xs btn-outline rounded-lg font-mono" id="demo-alumno">👤 Simular Alumno</button>
          <button type="button" class="btn btn-xs btn-outline rounded-lg font-mono" id="demo-docente">👨‍🏫 Simular Docente</button>
          <button type="button" class="btn btn-xs btn-outline rounded-lg font-mono" id="demo-directivo">🏫 Simular Directivo</button>
          <button type="button" class="btn btn-xs btn-primary rounded-lg font-mono" id="demo-qr">📱 Ir a Login QR (PC)</button>
        </div>
      </div>

    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
    import { ApiError, loginEmail, loginPassword, requestMagicLink } from '../lib/api';

    (() => {
      const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T | null;

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2800);
      }

      // Referencias Formulario
      const formEmail = $('#form-email-step')!;
      const formPassword = $('#form-password-step')!;
      const estadoMagic = $('#estado-magic-enviado')!;
      const inputEmail = $('#input-email') as HTMLInputElement;
      const docenteEmailDisplay = $('#docente-email-display') as HTMLInputElement;
      const alumnoMailEnviado = $('#alumno-mail-enviado')!;
      const inputPass = $('#input-password') as HTMLInputElement;

      function mostrarPasoPassword(email: string) {
        formEmail.hidden = true;
        formPassword.hidden = false;
        estadoMagic.hidden = true;
        docenteEmailDisplay.value = email;
        inputPass.value = '';
        inputPass.focus();
        aviso('Cuenta docente identificada. Ingresá tu contraseña.');
      }

      async function enviarMagicLink(email: string) {
        try {
          await requestMagicLink(email, 'login_pc');
          formEmail.hidden = true;
          formPassword.hidden = true;
          estadoMagic.hidden = false;
          alumnoMailEnviado.textContent = email;
          aviso('¡Link de acceso enviado a tu correo!');
        } catch (err) {
          aviso(mensajeDeError(err));
        }
      }

      // Copys del contrato §2.1 + genéricos §0
      function mensajeDeError(err: unknown): string {
        if (!(err instanceof ApiError)) return 'No pudimos conectar con el servidor. Intentá de nuevo.';
        switch (err.code) {
          case 'invalid_credentials':
            return err.message || 'Email o contraseña incorrectos.';
          case 'account_disabled':
            return err.message || 'Tu cuenta está desactivada; contactate con la dirección de la escuela.';
          case 'rate_limited': {
            const mins = err.retryAfter ? Math.ceil(err.retryAfter / 60) : 0;
            return `Demasiados intentos. Probá de nuevo${mins > 0 ? ` en ${mins} min` : ' más tarde'}.`;
          }
          default:
            return err.message || 'Ocurrió un error inesperado.';
        }
      }

      // Procesar Email — paso 1 real: POST /auth/login/email detecta el rol
      let enviandoEmail = false;
      formEmail.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (enviandoEmail) return;
        const email = inputEmail.value.trim();
        if (!email || !email.includes('@')) {
          inputEmail.focus();
          aviso('Por favor ingresá un correo electrónico válido.');
          return;
        }

        enviandoEmail = true;
        try {
          const { next } = await loginEmail(email);
          if (next === 'password') {
            mostrarPasoPassword(email);
          } else {
            // Alumno → magic link (contexto login_pc, CU-2)
            await enviarMagicLink(email);
          }
        } catch (err) {
          aviso(mensajeDeError(err));
        } finally {
          enviandoEmail = false;
        }
      });

      // Volver desde Password a Email
      $('#btn-volver-email').addEventListener('click', () => {
        formPassword.hidden = true;
        formEmail.hidden = false;
        inputEmail.focus();
      });

      // Volver desde Magic Link a Email
      $('#btn-cambiar-email-magic').addEventListener('click', () => {
        estadoMagic.hidden = true;
        formEmail.hidden = false;
        inputEmail.focus();
      });

      // Reenviar Magic Link
      $('#btn-reenviar-magic').addEventListener('click', () => {
        void enviarMagicLink(alumnoMailEnviado.textContent ?? '');
      });

      // Submit Docente — paso 2 real: POST /auth/login/password
      let ingresando = false;
      formPassword.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (ingresando) return;
        const pass = inputPass.value;
        if (!pass) {
          inputPass.focus();
          aviso('Ingresá tu contraseña.');
          return;
        }
        ingresando = true;
        try {
          await loginPassword(docenteEmailDisplay.value, pass);
          window.location.href = '/dashboard/';
        } catch (err) {
          aviso(mensajeDeError(err));
          ingresando = false;
        }
      });

      // Toggle Password
      $('#btn-toggle-pass').addEventListener('click', () => {
        const tipo = inputPass.type === 'password' ? 'text' : 'password';
        inputPass.type = tipo;
      });

      // Olvido contraseña
      $('#link-olvido-pass').addEventListener('click', (e) => {
        e.preventDefault();
        aviso('Comunicate con el administrador de la escuela para restablecer tu clave.');
      });

      // Código de Escuela o Aula
      const inputCodigo = $('#input-codigo');
      inputCodigo.addEventListener('input', function () {
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
      });

      $('#btn-ingresar-codigo').addEventListener('click', () => {
        const cod = inputCodigo.value.trim();
        if (!cod) {
          inputCodigo.focus();
          aviso('Ingresá el código de la escuela o de tu aula.');
          return;
        }
        aviso(`Ingresando con código «${cod}»…`);
        setTimeout(() => {
          window.location.href = '/materiales/';
        }, 700);
      });

      // Botones Demo
      $('#demo-alumno').addEventListener('click', () => {
        inputEmail.value = 'tiziano.maidana@alumnos.epet1.edu.ar';
        estadoMagic.hidden = true;
        formPassword.hidden = true;
        formEmail.hidden = false;
        formEmail.dispatchEvent(new Event('submit'));
      });

      $('#demo-docente').addEventListener('click', () => {
        inputEmail.value = 'profe.garcia@epet1.edu.ar';
        estadoMagic.hidden = true;
        formPassword.hidden = true;
        formEmail.hidden = false;
        formEmail.dispatchEvent(new Event('submit'));
      });

      $('#demo-directivo').addEventListener('click', () => {
        inputEmail.value = 'direccion@epet1.edu.ar';
        estadoMagic.hidden = true;
        formPassword.hidden = true;
        formEmail.hidden = false;
        formEmail.dispatchEvent(new Event('submit'));
      });

      $('#demo-qr').addEventListener('click', () => {
        window.location.href = '/pair/';
      });
    })();
  </script>
</Layout>

