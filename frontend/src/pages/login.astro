---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Entrar" active="login">
  <div class="py-8 md:py-12 flex justify-center">
    <div class="w-full max-w-md flex flex-col gap-6">

      <!-- Bienvenida -->
      <div class="text-center">
        <h1 class="font-display font-normal text-4xl md:text-5xl tracking-tight text-base-content">
          Buenas, ¿ya sos parte?
        </h1>
        <p class="mt-2 text-base-content/60 text-sm md:text-base">
          Mirá todo como visitante o entrá con tu cuenta: acá no hay contraseñas.
        </p>
      </div>

      <!-- Card de acceso -->
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-6 sm:p-7 gap-4">

          <!-- Tabs Entrar / Crear cuenta -->
          <div role="tablist" class="tabs tabs-box bg-base-200 p-1 rounded-xl grid grid-cols-2">
            <button
              type="button"
              role="tab"
              id="tab-entrar"
              class="tab tab-active font-semibold transition-all"
              aria-selected="true"
            >
              Entrar
            </button>
            <button
              type="button"
              role="tab"
              id="tab-crear"
              class="tab font-semibold transition-all text-base-content/70"
              aria-selected="false"
            >
              Crear cuenta
            </button>
          </div>

          <!-- Formulario Magic Link -->
          <form id="form-magic" novalidate class="flex flex-col gap-3">
            <div id="campo-nombre" class="form-control hidden flex-col gap-1.5">
              <label for="m-nombre" class="text-xs font-bold uppercase tracking-wider text-base-content/70">
                Nombre completo
              </label>
              <input
                id="m-nombre"
                type="text"
                autocomplete="name"
                placeholder="Valentina Costa"
                class="input input-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary"
              />
            </div>

            <div class="form-control flex flex-col gap-1.5">
              <label for="m-email" class="text-xs font-bold uppercase tracking-wider text-base-content/70">
                Email
              </label>
              <input
                id="m-email"
                type="email"
                autocomplete="email"
                placeholder="vos@alumnos.epet.edu.ar"
                class="input input-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary"
              />
            </div>

            <p class="text-xs text-base-content/50" id="hint-email">
              Si ya tenés cuenta, es el mismo email de siempre.
            </p>

            <button type="submit" id="btn-submit-magic" class="btn btn-primary rounded-xl w-full mt-1 font-semibold">
              Mandame el link de acceso
            </button>

            <!-- Nota sin password -->
            <div class="flex items-start gap-3 mt-2 p-3.5 rounded-xl bg-primary/10 border border-primary/20 text-xs text-base-content leading-relaxed">
              <svg class="size-4 shrink-0 text-primary mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                <path d="M8 10V7a4 4 0 0 1 7.5-2"></path>
              </svg>
              <p>
                <strong class="font-bold text-primary">Sin contraseñas para alumnos:</strong> te mandamos un link a tu email y entrás desde ahí.
              </p>
            </div>
          </form>

          <!-- Estado Link Enviado -->
          <div id="estado-enviado" hidden class="text-center py-4 flex flex-col items-center gap-3">
            <span class="size-14 rounded-full bg-primary/15 text-primary grid place-items-center mb-1">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
            </span>
            <h2 class="font-display font-normal text-3xl tracking-tight text-base-content">
              Listo, revisá tu correo
            </h2>
            <p class="text-sm text-base-content/70">
              Te mandamos un link a<br />
              <b class="font-mono text-base text-base-content font-bold" id="mail-enviado">vos@alumnos.epet.edu.ar</b>
            </p>
            <p class="text-xs text-base-content/60">
              Tocá el link del mail y entrás directo a tu cuenta.
            </p>
            <div class="flex gap-4 mt-2">
              <button type="button" id="btn-reenviar" class="btn btn-ghost btn-sm text-primary underline underline-offset-4">
                Reenviar link
              </button>
              <button type="button" id="btn-otro-mail" class="btn btn-ghost btn-sm text-base-content/60 hover:text-base-content">
                Usar otro email
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Bloque código de sala -->
      <div class="card bg-base-100 border-2 border-dashed border-base-300">
        <div class="card-body p-6 text-center gap-3">
          <h2 class="font-display font-normal text-2xl tracking-tight text-base-content">
            ¿Tenés código de sala?
          </h2>
          <p class="text-xs text-base-content/70 leading-relaxed">
            Como visitante podés ver todo el contenido educativo y los proyectos.
            Para <strong>entrar a una sala</strong> necesitás tu cuenta registrada: el código te une a la clase, pero no reemplaza el registro.
          </p>

          <div class="flex gap-2 mt-2">
            <input
              id="f-codigo"
              type="text"
              maxlength="7"
              placeholder="PROG5A"
              autocomplete="off"
              spellcheck="false"
              aria-label="Código de la sala"
              class="input input-bordered flex-1 rounded-xl text-center font-mono text-lg font-bold tracking-widest uppercase bg-base-200/60 focus:bg-base-100 focus:border-primary"
            />
            <button type="button" id="btn-unirme" class="btn btn-outline btn-primary rounded-xl px-5 font-semibold">
              Unirme
            </button>
          </div>
          <p class="text-[11px] text-base-content/50">
            Primero creá tu cuenta con el link; después ingresás el código una sola vez.
          </p>
        </div>
      </div>

      <!-- Link secundario: código de escuela -->
      <div class="text-center pt-1 pb-4">
        <a
          href="/materiales/"
          id="link-escuela"
          class="text-xs text-base-content/60 hover:text-primary underline underline-offset-4 transition-colors"
        >
          ¿Tenés código global de escuela? Ingresá para recorrer toda la institución sin cuenta →
        </a>
      </div>

    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script is:inline>
    (() => {
      const $ = (sel) => document.querySelector(sel);

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer = null;
      function aviso(msg) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2800);
      }

      // Tabs
      const tabEntrar = $('#tab-entrar');
      const tabCrear = $('#tab-crear');
      const campoNombre = $('#campo-nombre');
      const inputNombre = $('#m-nombre');
      const inputEmail = $('#m-email');
      const btnSubmit = $('#btn-submit-magic');
      const hintEmail = $('#hint-email');
      let modo = 'entrar';

      function setModo(m) {
        modo = m;
        if (modo === 'crear') {
          tabCrear.classList.add('tab-active');
          tabCrear.classList.remove('text-base-content/70');
          tabCrear.setAttribute('aria-selected', 'true');
          tabEntrar.classList.remove('tab-active');
          tabEntrar.classList.add('text-base-content/70');
          tabEntrar.setAttribute('aria-selected', 'false');

          campoNombre.classList.remove('hidden');
          campoNombre.classList.add('flex');
          btnSubmit.textContent = 'Crear cuenta y recibir link';
          hintEmail.textContent = 'Te enviaremos el magic link de confirmación para comenzar.';
        } else {
          tabEntrar.classList.add('tab-active');
          tabEntrar.classList.remove('text-base-content/70');
          tabEntrar.setAttribute('aria-selected', 'true');
          tabCrear.classList.remove('tab-active');
          tabCrear.classList.add('text-base-content/70');
          tabCrear.setAttribute('aria-selected', 'false');

          campoNombre.classList.add('hidden');
          campoNombre.classList.remove('flex');
          btnSubmit.textContent = 'Mandame el link de acceso';
          hintEmail.textContent = 'Si ya tenés cuenta, es el mismo email de siempre.';
        }
      }

      tabEntrar.addEventListener('click', () => setModo('entrar'));
      tabCrear.addEventListener('click', () => setModo('crear'));

      // Form submission
      const form = $('#form-magic');
      const estadoEnviado = $('#estado-enviado');
      const mailEnviado = $('#mail-enviado');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = inputEmail.value.trim();
        const nombre = inputNombre.value.trim();

        if (modo === 'crear' && !nombre) {
          inputNombre.focus();
          aviso('Decinos cómo te llamás para registrarte.');
          return;
        }

        if (!email || !email.includes('@')) {
          inputEmail.focus();
          aviso('Necesitamos un email válido para mandarte el link.');
          return;
        }

        mailEnviado.textContent = email;
        form.hidden = true;
        estadoEnviado.hidden = false;
        aviso('¡Magic link enviado! Revisá tu casilla.');
      });

      $('#btn-reenviar').addEventListener('click', () => {
        aviso(`Te enviamos el link nuevamente a ${mailEnviado.textContent}.`);
      });

      $('#btn-otro-mail').addEventListener('click', () => {
        estadoEnviado.hidden = true;
        form.hidden = false;
        inputEmail.focus();
      });

      // Código de sala
      const fCodigo = $('#f-codigo');
      fCodigo.addEventListener('input', function () {
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
      });

      $('#btn-unirme').addEventListener('click', () => {
        const cod = fCodigo.value.trim();
        if (!cod) {
          fCodigo.focus();
          aviso('Escribí el código de sala que te pasó el docente.');
          return;
        }
        if (!form.hidden) {
          aviso('Primero creá tu cuenta con el link: el código no reemplaza el registro.');
          inputEmail.focus();
          return;
        }
        aviso(`Buscando la sala «${cod}»…`);
        setTimeout(() => {
          window.location.href = '/mis-salas/';
        }, 800);
      });
    })();
  </script>
</Layout>
