---
import Layout from '../layouts/Layout.astro';
import { sandboxes, salaDe, estadoInfo, tipoLabel, CAPACIDAD } from '../data/mock';

const corriendo = sandboxes.filter((s) => s.estado === 'running').length;
---

<Layout titulo="Sandboxes" active="sandboxes">
  <div class="py-8">
    <h1 class="font-display font-normal text-5xl tracking-tight">Sandboxes</h1>
    <p class="mt-2 text-base-content/60">Los proyectos del curso, corriendo en el server de la escuela.</p>

    <div class="card bg-base-100 border border-base-300 mt-6" aria-label="Presupuesto de sandboxes">
      <div class="card-body p-4 flex-row items-center gap-4 flex-wrap">
        <span class="text-sm">
          <b class="font-display text-lg">{corriendo}</b> de <b>{CAPACIDAD}</b> sandboxes prendidos
        </span>
        <progress
          class="progress progress-primary w-44"
          value={corriendo}
          max={CAPACIDAD}
          aria-label={`${corriendo} de ${CAPACIDAD} sandboxes en uso`}
        ></progress>
        <span class="badge badge-ghost font-normal">server de la escuela</span>
      </div>
    </div>
    <p class="mt-3 text-xs text-base-content/60">
      La máquina de la escuela corre hasta {CAPACIDAD} sandboxes a la vez. Si está lleno, esperá tu turno: se libera rápido.
    </p>

    <div class="grid md:grid-cols-2 gap-4 mt-6">
      {sandboxes.map((sb) => {
        const estado = estadoInfo[sb.estado];
        const sala = salaDe(sb.salaId);
        return (
          <article class="card bg-base-100 border border-base-300 hover:border-base-300 transition-colors">
            <div class="card-body p-4 gap-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h2 class="font-semibold leading-snug">{sb.titulo}</h2>
                  <p class="text-sm text-base-content/60 mt-0.5">
                    por <span class="font-mono text-xs">{sb.autor}</span>
                  </p>
                </div>
                <span class:list={['badge normal-case tracking-wide shrink-0', estado.badge]}>
                  {sb.estado === 'running' && (
                    <i class="inline-block size-2 rounded-full bg-current animate-pulse" aria-hidden="true"></i>
                  )}
                  {estado.label}
                </span>
              </div>

              <div class="flex gap-2 flex-wrap items-center">
                <span class="badge badge-outline font-mono text-[11px]">{tipoLabel[sb.tipo]}</span>
                <span class="badge badge-outline font-mono text-[11px]">{sb.modo}</span>
                {sb.url && (
                  <a href={`http://${sb.url}`} onclick="return false" class="font-mono text-xs text-primary underline underline-offset-2">
                    {sb.url}
                  </a>
                )}
              </div>

              <div class="card-actions justify-between items-center pt-3 mt-1 border-t border-base-300">
                <span class="text-xs text-base-content/60">{sala?.nombre} · <span class="font-mono">{sala?.codigo}</span></span>
                <a href={`/sandboxes/${sb.id}/`} class="btn btn-sm rounded-full bg-base-100 border border-base-300 hover:border-base-content">
                  Ver detalle
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>
