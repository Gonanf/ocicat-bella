---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Nueva consigna" active="consignas" navRole="docente">
  <div class="py-6 sm:py-10 space-y-6">

    <!-- Hero Header -->
    <section class="pb-2">
      <a
        href="/consignas/"
        id="link-volver"
        class="inline-flex items-center gap-1.5 text-xs text-base-content/60 hover:text-primary transition-colors font-medium mb-2.5"
      >
        ← Consignas del aula
      </a>
      <h1 class="font-display font-normal text-3xl sm:text-4xl md:text-5xl tracking-tight text-base-content">
        Nueva consigna
      </h1>
      <p class="text-sm text-base-content/70 mt-1 max-w-xl" id="subtitulo-aula">
        Cargando aula… Se publica apenas la creás y los alumnos la ven al instante.
      </p>
    </section>

    <!-- Formulario Nueva Consigna -->
    <div class="card bg-base-100 border border-base-300 shadow-sm max-w-3xl p-6 sm:p-8">
      <form id="form-consigna" class="space-y-6" novalidate>

        <!-- Sección: Contenido -->
        <div class="space-y-4">
          <p class="text-xs font-bold uppercase tracking-widest text-primary">
            Contenido
          </p>

          <div class="form-control flex flex-col gap-1.5">
            <label for="f-titulo" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Título de la consigna
            </label>
            <input
              id="f-titulo"
              name="titulo"
              type="text"
              required
              autocomplete="off"
              placeholder="ej. TP2 — Manejo de archivos"
              class="input input-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary text-base font-medium"
            />
          </div>

          <div class="form-control flex flex-col gap-1.5">
            <label for="f-instrucciones" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Instrucciones y Enunciado
            </label>
            <textarea
              id="f-instrucciones"
              name="instrucciones"
              required
              rows="5"
              placeholder="Qué tienen que hacer, cómo se evalúa y qué archivos se espera recibir…"
              class="textarea textarea-bordered w-full rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary text-sm leading-relaxed"
            ></textarea>
          </div>
        </div>

        <hr class="border-base-200" />

        <!-- Sección: Adjuntos -->
        <div class="space-y-3">
          <p class="text-xs font-bold uppercase tracking-widest text-primary">
            Adjuntos (opcional)
          </p>

          <label
            for="f-archivos"
            id="dropzone"
            tabindex="0"
            role="button"
            aria-label="Subir archivos adjuntos para la consigna"
            class="border-2 border-dashed border-base-300 hover:border-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 bg-base-200/40 hover:bg-primary/5 rounded-2xl p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-all gap-2"
          >
            <svg class="size-6 text-base-content/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4M7 9l5-5 5 5"></path>
              <path d="M4 16v3a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 19v-3"></path>
            </svg>
            <div class="text-sm text-base-content">
              Arrastrá hasta acá o <strong class="text-primary underline">elegí archivos</strong>
            </div>
            <p class="text-xs text-base-content/50">
              PDF, imágenes o código · máx. 10 MB por archivo
            </p>
          </label>
          <input
            id="f-archivos"
            type="file"
            multiple
            class="sr-only"
            tabindex="-1"
            accept=".pdf,.png,.jpg,.jpeg,.zip,.py,.ino,.cpp,.html,.css,.js"
          />
          <!-- Cada adjunto se sube al momento (POST /assignments/attachments) y queda listo para referenciar. -->
          <ul class="space-y-2 text-xs" id="lista-archivos"></ul>
        </div>

        <hr class="border-base-200" />

        <!-- Sección: Corrección Automática / Runtime -->
        <div class="space-y-3">
          <p class="text-xs font-bold uppercase tracking-widest text-primary">
            Corrección automática y Sandbox
          </p>

          <fieldset class="space-y-2">
            <legend class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Entorno del ejercicio · qué pueden usar los alumnos (§13.3)
            </legend>
            <div class="flex flex-wrap gap-2.5" role="radiogroup" aria-label="Runtime esperado">
              <label class="cursor-pointer">
                <input type="radio" name="runtime" value="python" class="peer sr-only" checked />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  Python 3.11
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="runtime" value="web" class="peer sr-only" />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  Web (HTML/Node)
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="runtime" value="cpp" class="peer sr-only" />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  C++ (GCC)
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="runtime" value="arduino" class="peer sr-only" />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  Arduino Uno (Simulación)
                </span>
              </label>
            </div>
          </fieldset>
        </div>

        <hr class="border-base-200" />

        <!-- Sección: Entrega, Intentos y Tardías -->
        <div class="space-y-4">
          <p class="text-xs font-bold uppercase tracking-widest text-primary">
            Configuración de entrega
          </p>

          <div class="form-control flex flex-col gap-1.5">
            <label for="f-vencimiento" class="text-xs font-bold uppercase tracking-wider text-base-content/80">
              Fecha límite (opcional)
            </label>
            <input
              id="f-vencimiento"
              name="vencimiento"
              type="datetime-local"
              class="input input-bordered w-full max-w-xs rounded-xl bg-base-200/60 focus:bg-base-100 focus:border-primary text-sm"
            />
            <p class="text-xs text-base-content/50">
              Si lo dejás vacío, la consigna queda como práctica continua sin vencimiento.
            </p>
          </div>

          <!-- Intentos permitidos -->
          <div class="space-y-2">
            <label class="text-xs font-bold uppercase tracking-wider text-base-content/80 block">
              Intentos permitidos
            </label>
            <div class="flex flex-wrap items-center gap-2.5">
              <label class="cursor-pointer">
                <input type="radio" name="intentos" value="ilimitados" class="peer sr-only" checked />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  Ilimitados (default)
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intentos" value="n" class="peer sr-only" />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  N intentos
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intentos" value="uno" class="peer sr-only" />
                <span class="inline-flex items-center px-4 py-2 rounded-full border border-base-300 text-xs font-semibold peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary transition-all">
                  Uno solo
                </span>
              </label>
            </div>

            <!-- Campo condicional para N intentos -->
            <div id="intentos-extra" class="hidden items-center gap-2 pt-2">
              <label for="f-intentos-num" class="text-xs text-base-content/70 font-medium">
                Cantidad máxima de entregas:
              </label>
              <input
                id="f-intentos-num"
                type="number"
                min="2"
                max="10"
                value="3"
                class="input input-bordered input-sm w-20 rounded-lg text-center font-mono font-bold"
              />
            </div>
          </div>

          <!-- Switch Entregas Tardías -->
          <div class="p-4 rounded-xl bg-base-200/70 border border-base-300 flex items-start justify-between gap-4">
            <div>
              <strong class="text-xs font-bold uppercase tracking-wider text-base-content block">
                Permitir entregas tardías
              </strong>
              <p class="text-xs text-base-content/65 mt-0.5 max-w-md">
                Llegan después de la fecha límite y quedan marcadas como tardías para corregir igual.
              </p>
            </div>
            <input
              type="checkbox"
              id="f-tardias"
              checked
              class="toggle toggle-primary shrink-0"
              aria-label="Permitir entregas tardías"
            />
          </div>

          <!-- Nota informativa -->
          <div class="p-3.5 rounded-xl bg-primary/10 border border-primary/20 flex items-start gap-2.5 text-xs text-base-content/80">
            <svg class="size-4.5 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 8h.01M12 11v5"></path>
            </svg>
            <p>
              <strong class="font-bold text-primary">Esta configuración es modificable en cualquier momento,</strong> incluso con la consigna ya publicada y con entregas recibidas.
            </p>
          </div>
        </div>

        <!-- Acciones del Formulario -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-base-200">
          <a href="/consignas/" id="btn-cancelar" class="btn btn-ghost btn-sm rounded-xl">
            Cancelar
          </a>
          <button type="submit" class="btn btn-primary btn-sm md:btn-md rounded-xl font-semibold px-6" id="btn-crear">
            Crear consigna
          </button>
        </div>

      </form>
    </div>

  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
    import {
      ApiError, createAssignment, getClassroom, uploadAttachment,
      type AssignmentAttachment, type AttemptsConfig,
    } from '../lib/api';

    (() => {
      const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T | null;

      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2600);
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      }

      const classroomId = new URLSearchParams(window.location.search).get('classroom') ?? '';
      if (!classroomId) {
        $('#subtitulo-aula')!.textContent = 'Falta el aula: entrá desde «Consignas» para crear una consigna.';
        ($('#btn-crear') as HTMLButtonElement).disabled = true;
      }

      // Header con nombre real del aula
      void (async () => {
        if (!classroomId) return;
        try {
          const aula = await getClassroom(classroomId);
          document.title = `Nueva consigna · ${aula.name}`;
          $('#subtitulo-aula')!.textContent = `Para ${aula.name}. Se publica apenas la creás y los alumnos la ven al instante.`;
          $('#link-volver')!.href = `/consignas/?classroom=${encodeURIComponent(classroomId)}`;
          $('#btn-cancelar')!.setAttribute('href', `/consignas/?classroom=${encodeURIComponent(classroomId)}`);
        } catch { /* header genérico */ }
      })();

      // --- Dropzone: cada archivo se sube YA (POST /assignments/attachments, §4) ---
      const MAX_BYTES = 10 * 1024 * 1024;
      const inputArchivos = $('#f-archivos') as HTMLInputElement;
      const listaArchivos = $('#lista-archivos')!;
      /** Subidos listos para attachment_ids; los que fallan no entran. */
      const subidos = new Map<string, AssignmentAttachment>();

      function pesoLegible(bytes: number): string {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return Math.round(bytes / 1024) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
      }

      function pintarAdjunto(att: AssignmentAttachment | null, key: string, estado: 'subiendo' | 'listo' | 'error'): HTMLElement {
        const li = document.createElement('li');
        li.className = 'p-2.5 rounded-xl bg-base-200 border border-base-300 flex items-center justify-between gap-2';
        li.dataset.key = key;
        li.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            ${estado === 'subiendo'
              ? '<span class="loading loading-spinner loading-xs text-primary"></span>'
              : estado === 'listo'
                ? '<svg class="size-3.5 text-success shrink-0 stroke-[3]" viewBox="0 0 14 14" fill="none" stroke="currentColor"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                : '<span class="badge badge-error badge-sm text-error">error</span>'}
            <span class="font-medium text-base-content truncate">${escapeHtml(att?.filename ?? key)}</span>
            ${att ? `<span class="badge badge-ghost font-mono text-[10px]">${pesoLegible(att.size_bytes)}</span>` : ''}
          </div>
          ${estado === 'error'
            ? ''
            : '<button type="button" class="btn btn-ghost btn-xs text-error font-medium">Quitar</button>'}
        `;
        li.querySelector('button')?.addEventListener('click', () => {
          subidos.delete(key);
          li.remove();
          aviso(`Quitaste «${att?.filename ?? key}» del borrador (el archivo se borra solo en 24 h si no lo usás).`);
        });
        return li;
      }

      async function subirArchivos(files: FileList) {
        for (const file of Array.from(files)) {
          const key = `${file.name}:${file.size}:${file.lastModified}`;
          if ([...subidos.keys()].includes(key)) continue;
          if (file.size > MAX_BYTES) {
            listaArchivos.appendChild(pintarAdjunto(null, file.name, 'error'));
            aviso(`«${file.name}» pasa los 10 MB por archivo.`);
            continue;
          }
          const li = pintarAdjunto(null, key, 'subiendo');
          listaArchivos.appendChild(li);
          try {
            const att = await uploadAttachment(file);
            subidos.set(key, att);
            li.replaceWith(pintarAdjunto(att, key, 'listo'));
          } catch (err) {
            li.remove();
            listaArchivos.appendChild(pintarAdjunto(null, file.name, 'error'));
            aviso(err instanceof ApiError && err.message ? err.message : `No pudimos subir «${file.name}».`);
          }
        }
      }

      const dropzone = $('#dropzone')!;
      dropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          inputArchivos.click();
        }
      });
      ['dragenter', 'dragover'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-primary', 'bg-primary/5');
        }),
      );
      ['dragleave', 'drop'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-primary', 'bg-primary/5');
        }),
      );
      dropzone.addEventListener('drop', (e) => {
        if (e.dataTransfer?.files.length) void subirArchivos(e.dataTransfer.files);
      });
      inputArchivos.addEventListener('change', () => {
        if (inputArchivos.files?.length) void subirArchivos(inputArchivos.files);
        inputArchivos.value = '';
      });

      // Intentos toggle
      const extra = $('#intentos-extra')!;
      document.querySelectorAll<HTMLInputElement>('input[name="intentos"]').forEach((r) => {
        r.addEventListener('change', () => {
          extra.classList.toggle('hidden', r.value !== 'n');
          extra.classList.toggle('flex', r.value === 'n');
        });
      });

      // Submit real: POST /classrooms/{id}/assignments (§4)
      ($('#form-consigna') as HTMLFormElement).addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!classroomId) return;

        const titulo = ($('#f-titulo') as HTMLInputElement).value.trim();
        const instrucciones = ($('#f-instrucciones') as HTMLTextAreaElement).value.trim();
        if (!titulo) {
          ($('#f-titulo') as HTMLInputElement).focus();
          aviso('Ponéle un título a la consigna.');
          return;
        }
        if (!instrucciones) {
          ($('#f-instrucciones') as HTMLTextAreaElement).focus();
          aviso('Completá las instrucciones para los alumnos.');
          return;
        }

        const runtime = document.querySelector<HTMLInputElement>('input[name="runtime"]:checked')!.value;
        const vencimientoLocal = ($('#f-vencimiento') as HTMLInputElement).value;
        const dueAt = vencimientoLocal ? new Date(vencimientoLocal).toISOString() : undefined;

        const modoIntentos = document.querySelector<HTMLInputElement>('input[name="intentos"]:checked')!.value;
        let attempts: AttemptsConfig = { mode: 'unlimited' };
        if (modoIntentos === 'one') {
          attempts = { mode: 'one' };
        } else if (modoIntentos === 'n') {
          const max = Number(($('#f-intentos-num') as HTMLInputElement).value);
          if (!Number.isInteger(max) || max < 2 || max > 10) {
            ($('#f-intentos-num') as HTMLInputElement).focus();
            aviso('La cantidad de intentos tiene que ser un número entre 2 y 10.');
            return;
          }
          attempts = { mode: 'limited', max };
        }

        const btn = $('#btn-crear') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Publicando…';
        try {
          await createAssignment(classroomId, {
            title: titulo,
            instructions: instrucciones,
            attachment_ids: [...subidos.values()].map((a) => a.attachment_id),
            runtime: runtime as 'python' | 'web' | 'cpp' | 'arduino',
            due_at: dueAt,
            attempts,
            late_policy: (($('#f-tardias') as HTMLInputElement).checked ? 'allowed' : 'closed'),
          });
          aviso(`¡Consigna «${titulo}» creada y publicada!`);
          setTimeout(() => {
            window.location.href = `/consignas/?classroom=${encodeURIComponent(classroomId)}`;
          }, 900);
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          aviso(err instanceof ApiError && err.message ? err.message : 'No pudimos crear la consigna.');
          btn.disabled = false;
          btn.textContent = 'Crear consigna';
        }
      });
    })();
  </script>
</Layout>
