---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Configuración del aula" active="aulas" navRole="docente">
  <div class="py-6 sm:py-10 space-y-6">

    <!-- Hero Header -->
    <section class="pb-2">
      <a
        id="nav-volver"
        href="/dashboard/"
        class="inline-flex items-center gap-1.5 text-xs text-base-content/60 hover:text-primary transition-colors font-medium mb-2.5"
      >
        ← <span id="h-nombre">Aulas</span>
      </a>
      <p class="font-mono text-xs font-bold uppercase tracking-widest text-primary">
        <span id="h-detalle">Cargando aula…</span>
      </p>
      <h1 class="font-display font-normal text-3xl sm:text-4xl md:text-5xl tracking-tight text-base-content mt-1">
        Configuración del aula
      </h1>
      <p class="text-sm text-base-content/70 mt-1 max-w-xl">
        Definí qué plantillas pueden usar tus alumnos cuando abren un sandbox en esta aula (§10.2).
      </p>
    </section>

    <!-- Sub-navegación del aula -->
    <nav class="flex gap-1.5 overflow-x-auto pb-1 border-b border-base-300 text-sm font-medium" aria-label="Secciones del aula">
      <a
        id="nav-consignas"
        href="/consignas/"
        class="px-4 py-2 rounded-xl text-base-content/70 hover:bg-base-300 hover:text-base-content transition-colors"
      >
        Consignas
      </a>
      <a
        id="nav-alumnos"
        href="/alumnos/"
        class="px-4 py-2 rounded-xl text-base-content/70 hover:bg-base-300 hover:text-base-content transition-colors"
      >
        Alumnos
      </a>
      <a
        href="/sala-config/"
        class="px-4 py-2 rounded-xl bg-primary text-primary-content font-semibold"
        aria-current="page"
      >
        Configuración
      </a>
    </nav>

    <!-- Formulario de Configuración -->
    <div class="card bg-base-100 border border-base-300 shadow-sm max-w-3xl p-6 sm:p-8">
      <form id="form-config" class="space-y-8" novalidate>

        <!-- SECCIÓN 1: Qué pueden usar los alumnos (entornos del ejercicio) -->
        <div class="space-y-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-primary">
              Plantillas permitidas (allowed_templates)
            </p>
            <p class="text-xs text-base-content/70 mt-0.5">
              Elegí las plantillas de entorno base con las que pueden trabajar los alumnos en esta aula.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="grid-templates">
            <p class="p-6 text-sm text-base-content/60 text-center sm:col-span-2">Cargando plantillas…</p>
          </div>

          <p class="text-xs text-base-content/60 font-medium">
            <strong class="text-base-content font-bold" id="tpl-num">0</strong> de <span id="tpl-total">4</span> entornos habilitados para los alumnos.
          </p>
        </div>

        <hr class="border-base-200" />

        <!-- SECCIÓN 2: Avanzado - Dockerfile propio -->
        <div class="space-y-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-primary">
              Avanzado
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-base-200/60 border border-base-300 flex items-start justify-between gap-4">
            <div>
              <strong class="text-xs font-bold uppercase tracking-wider text-base-content block">
                Permitir Dockerfile personalizado (custom_dockerfile_enabled)
              </strong>
              <p class="text-xs text-base-content/70 mt-0.5 max-w-lg leading-relaxed">
                Sin esto, todos parten de las plantillas de entorno permitidas arriba.
              </p>
            </div>
            <input
              type="checkbox"
              id="f-custom-dockerfile"
              class="toggle toggle-warning shrink-0"
              aria-label="Permitir Dockerfile personalizado"
            />
          </div>

          <!-- Alerta de seguridad pedagógica -->
          <div class="p-4 rounded-xl bg-warning/15 border border-warning/30 flex items-start gap-3 text-xs text-base-content">
            <svg class="size-5 text-warning shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3 2.5 20h19L12 3Z"></path>
              <path d="M12 10v4"></path>
              <path d="M12 17h.01"></path>
            </svg>
            <p class="leading-relaxed">
              <strong>Mantenelo apagado salvo que un proyecto lo requiera:</strong> un Dockerfile propio puede intentar descargar dependencias pesadas o consumir recursos excesivos del servidor escolar.
            </p>
          </div>
        </div>

        <div id="error-config" class="hidden p-4 rounded-xl bg-error/10 border border-error/25 text-xs text-error font-medium" role="alert"></div>

        <!-- Guardar Configuración -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-base-200">
          <p class="text-xs text-base-content/60 max-w-sm">
            Los cambios se aplican a los sandboxes nuevos; los que ya están corriendo continúan como están.
          </p>
          <button
            type="submit"
            id="btn-guardar"
            class="btn btn-primary btn-sm md:btn-md rounded-xl font-semibold px-6 shrink-0"
          >
            Guardar configuración
          </button>
        </div>

      </form>
    </div>

  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
    import {
      ApiError, getClassroom, listTemplates, patchClassroomSettings,
      type Template
    } from '../lib/api';

    (() => {
      const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T | null;

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2600);
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      }

      const classroomId = new URLSearchParams(window.location.search).get('classroom') ?? '';
      if (!classroomId) {
        window.location.href = '/dashboard/';
        return;
      }

      const TEMPLATE_DESCRIPTIONS: Record<string, string> = {
        'python/numpy': 'Python 3.11 con NumPy, Pandas, Matplotlib y SciPy (modo job)',
        'bun/react': 'Bun + React y Vite listos para SPA (modo service web)',
        'cpp/sqlite': 'C++ (GCC) con SQLite3 para bases de datos y algoritmos (modo job)',
        'arduino': 'Arduino CLI con compilación y simulación Uno (modo job)',
      };

      let todosLosTemplates: Template[] = [];
      let allowedMap: Record<string, boolean> = {};

      function refrescarConteo() {
        const tpls = document.querySelectorAll<HTMLInputElement>('input[name="tpl"]');
        let count = 0;
        tpls.forEach((t) => { if (t.checked) count++; });
        const numEl = $('#tpl-num');
        if (numEl) numEl.textContent = String(count);
      }

      function renderTemplatesGrid() {
        const grid = $('#grid-templates');
        if (!grid) return;

        $('#tpl-total')!.textContent = String(todosLosTemplates.length);

        grid.innerHTML = todosLosTemplates.map((t) => {
          const checked = allowedMap[t.id] ?? true;
          const desc = TEMPLATE_DESCRIPTIONS[t.id] || `Modo ${t.mode_default} · ${t.runtimes.join(', ')}`;
          return `
            <label class="card bg-base-200/50 hover:bg-primary/5 border border-base-300 has-[:checked]:border-primary has-[:checked]:bg-primary/5 p-4 rounded-2xl cursor-pointer transition-all flex flex-col justify-between gap-2 select-none group">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono font-bold text-sm text-base-content group-hover:text-primary">
                  ${escapeHtml(t.label)} <span class="text-xs font-normal text-base-content/60">(${escapeHtml(t.id)})</span>
                </span>
                <input
                  type="checkbox"
                  name="tpl"
                  value="${escapeHtml(t.id)}"
                  ${checked ? 'checked' : ''}
                  class="checkbox checkbox-primary checkbox-sm rounded-lg"
                />
              </div>
              <p class="text-xs text-base-content/65 leading-relaxed">
                ${escapeHtml(desc)}
              </p>
            </label>
          `;
        }).join('');

        document.querySelectorAll<HTMLInputElement>('input[name="tpl"]').forEach((el) => {
          el.addEventListener('change', refrescarConteo);
        });
        refrescarConteo();
      }

      async function init() {
        try {
          const [aula, allTplRes, allowedTplRes] = await Promise.all([
            getClassroom(classroomId),
            listTemplates(),
            listTemplates(classroomId),
          ]);

          const set = (id: string, v?: string) => {
            const el = document.getElementById(id);
            if (el && v) el.textContent = v;
          };
          set('h-nombre', aula.name);
          set('h-detalle', [aula.name, aula.course, aula.shift].filter(Boolean).join(' · '));
          document.title = `Configuración — ${aula.name}`;

          const navC = document.getElementById('nav-consignas') as HTMLAnchorElement | null;
          const navA = document.getElementById('nav-alumnos') as HTMLAnchorElement | null;
          if (navC) navC.href = '/consignas/?classroom=' + encodeURIComponent(classroomId);
          if (navA) navA.href = '/alumnos/?classroom=' + encodeURIComponent(classroomId);

          todosLosTemplates = allTplRes.templates;
          allowedMap = {};
          allowedTplRes.templates.forEach((t) => { allowedMap[t.id] = true; });

          renderTemplatesGrid();
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          window.location.href = '/dashboard/';
        }
      }

      // Submit Form
      $('#form-config')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errBox = $('#error-config')!;
        errBox.classList.add('hidden');
        errBox.textContent = '';

        const selected: string[] = [];
        document.querySelectorAll<HTMLInputElement>('input[name="tpl"]:checked').forEach((input) => {
          selected.push(input.value);
        });

        if (selected.length === 0) {
          errBox.textContent = 'Tenés que habilitar al menos un entorno para los alumnos.';
          errBox.classList.remove('hidden');
          return;
        }

        const customDocker = ($('#f-custom-dockerfile') as HTMLInputElement)?.checked ?? false;
        const btn = $('#btn-guardar') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Guardando…';

        try {
          await patchClassroomSettings(classroomId, {
            allowed_templates: selected,
            custom_dockerfile_enabled: customDocker,
          });
          aviso('Configuración guardada. Se aplica a los sandboxes nuevos.');
        } catch (err) {
          if (err instanceof ApiError) {
            errBox.textContent = err.message || 'No pudimos guardar la configuración.';
          } else {
            errBox.textContent = 'No pudimos conectar con el servidor.';
          }
          errBox.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Guardar configuración';
        }
      });

      void init();
    })();
  </script>
</Layout>
