---
import Layout from '../../layouts/Layout.astro';
import { sandboxes, salaDe, estadoInfo, tipoLabel } from '../../data/mock';

export function getStaticPaths() {
  return sandboxes.map((sb) => ({ params: { id: sb.id }, props: { sb } }));
}

interface Props {
  sb: (typeof sandboxes)[number];
}

const { sb } = Astro.props;
const sala = salaDe(sb.salaId);
const estado = estadoInfo[sb.estado];
const exitChip = (exit: number) =>
  exit === 0 ? 'badge-success badge-soft' : exit === 124 ? 'badge-warning badge-soft' : 'badge-error badge-soft';
---

<Layout titulo={`${sb.titulo} — Sandbox`} active="sandboxes">
  <div class="pt-8 pb-2">
    <nav aria-label="Volver" class="text-sm text-base-content/60">
      <a href="/sandboxes/" class="hover:text-base-content hover:underline">← Volver a Sandboxes</a>
    </nav>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-display font-normal text-4xl tracking-tight">{sb.titulo}</h1>
        <div class="flex gap-2 flex-wrap items-center mt-2">
          <span class="badge badge-outline font-mono text-[11px]">{tipoLabel[sb.tipo]}</span>
          <span class="badge badge-outline font-mono text-[11px]">sb-{sb.numero}</span>
          <span class:list={['badge normal-case tracking-wide', estado.badge]}>
            {sb.estado === 'running' && (
              <i class="inline-block size-2 rounded-full bg-current animate-pulse" aria-hidden="true"></i>
            )}
            {estado.label}
          </span>
        </div>
      </div>
      <div class="flex gap-2 flex-wrap">
        <button type="button" class="btn btn-md rounded-full bg-base-100 border border-base-300 hover:border-base-content" disabled={sb.estado === 'running'}>
          ▶ Iniciar
        </button>
        <button type="button" class="btn btn-primary btn-md rounded-full" disabled={sb.estado === 'stopped'}>■ Detener</button>
        <button type="button" class="btn btn-ghost btn-md rounded-full">Correr de nuevo</button>
      </div>
    </div>
  </div>

  <div class="grid lg:grid-cols-[1fr_330px] gap-6 items-start mt-6 pb-4">
    <section aria-label="Logs y ejecuciones">
      <div class="rounded-2xl overflow-hidden border border-[#1E2A44] shadow-lg">
        <div class="flex justify-between items-center px-4 py-2 bg-[#0B1222] font-mono text-[11px] tracking-wider text-[#8AA0C2]">
          <span>logs · sb-{sb.numero} · backend docker</span>
          {sb.estado === 'running' && (
            <span class="inline-flex items-center gap-2 uppercase">
              <i class="inline-block size-2 rounded-full bg-[#7CFFB2] animate-pulse" aria-hidden="true"></i>en vivo
            </span>
          )}
          {sb.estado === 'stopped' && <span class="uppercase">detenido</span>}
          {sb.estado === 'historical' && <span class="uppercase">registro histórico</span>}
        </div>
        <div
          class="mockup-code rounded-none border-0 min-h-80 max-h-[28rem] overflow-auto text-[12.5px] bg-terminal text-terminal-text"
          role="log"
          tabindex="0"
          aria-label="Salida de la ejecución"
        >
          {sb.logs.map((l) => (
            <pre data-prefix={l.p ?? ''}><code>{l.t}</code></pre>
          ))}
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 mt-6" aria-label="Historial de ejecuciones">
        <div class="card-body p-4 overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr><th>Ejecución</th><th>Resultado</th><th>Exit code</th><th>Cuándo</th></tr>
            </thead>
            <tbody>
              {sb.historial.map((h) => (
                <tr>
                  <td class="font-medium">#{h.n}</td>
                  <td>{h.resultado}</td>
                  <td><span class:list={['badge badge-sm font-mono', exitChip(h.exit)]}>exit={h.exit}</span></td>
                  <td class="text-base-content/60 whitespace-nowrap">{h.cuando}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <aside class="card bg-base-100 border border-base-300 lg:sticky lg:top-24" aria-label="Datos del sandbox">
      <div class="card-body p-5 gap-1">
        <h2 class="font-display font-normal text-xl mb-2">Datos del sandbox</h2>
        <dl class="text-sm divide-y divide-dashed divide-line">
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Modo</dt><dd class="text-right">{sb.modo === 'job' ? 'job · playground efímero' : 'service · siempre prendido'}</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Retención</dt><dd class="text-right">{sb.estado === 'historical' ? 'histórico · re-instanciable' : 'estándar'}</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Lenguaje</dt><dd class="text-right">{sb.lenguaje}</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Autor</dt><dd class="text-right font-mono text-xs">{sb.autor}</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Sala</dt><dd class="text-right">{sala?.nombre} · <span class="font-mono text-xs text-primary">{sala?.codigo}</span></dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Última ejecución</dt><dd class="text-right">{sb.ultimaEjecucion}</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Exit code</dt><dd><span class:list={['badge badge-sm font-mono', exitChip(sb.ultimoExit)]}>{sb.ultimoExit}</span></dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Backend</dt><dd class="font-mono text-xs">docker</dd></div>
          <div class="flex justify-between gap-3 py-2"><dt class="text-base-content/60">Límites</dt><dd class="font-mono text-xs text-right">{sb.limites}</dd></div>
        </dl>
      </div>
    </aside>
  </div>
</Layout>
