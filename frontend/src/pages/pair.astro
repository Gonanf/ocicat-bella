---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Conectar con QR" active="pair" hideNav={false}>
  <div class="py-6 md:py-10 flex flex-col items-center">
    
    <!-- Contenedor Principal Pair -->
    <div class="w-full max-w-[860px] card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
      
      <!-- Barra de identificación de equipo -->
      <div class="bg-base-200/80 border-b border-base-300 px-5 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="relative flex size-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
            <span class="relative inline-flex rounded-full size-2.5 bg-success"></span>
          </span>
          <span class="font-mono font-bold text-sm text-primary tracking-wide" id="eq-label">Esta PC</span>
        </div>

        <div class="badge badge-outline font-mono text-[11px] text-base-content/70">
          Terminal Escolar Compartida
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-base-300">

        <!-- Columna Izquierda: Código QR de un solo uso -->
        <div class="p-6 sm:p-8 flex flex-col items-center justify-center text-center bg-base-200/40">
          
          <div class="relative p-4 bg-white rounded-2xl border-2 border-base-300 shadow-md group transition-transform hover:scale-[1.02]" id="qr-wrapper">
            <!-- QR real renderizado en cliente desde qr_url (§2.3) -->
            <canvas id="qr-canvas" class="size-52 sm:size-56 block" role="img" aria-label="Código QR para inicio de sesión en esta PC">
              <p class="p-4 text-xs">Generando código QR…</p>
            </canvas>

            <!-- Overlay de Estado (cuando escanea o conecta) -->
            <div class="absolute inset-0 bg-base-100/95 rounded-2xl hidden flex-col items-center justify-center p-5 text-base-content backdrop-blur-xs" id="qr-overlay">
              <span class="loading loading-spinner text-primary size-9 mb-3"></span>
              <strong id="qr-overlay-title" class="text-sm font-bold text-base-content">Dispositivo detectado</strong>
              <p id="qr-overlay-desc" class="text-xs text-base-content/70 mt-1">Confirmá en tu celular para acceder.</p>
            </div>
          </div>

          <!-- Barra de expiración de QR (TTL 60s) -->
          <div class="w-full max-w-[220px] h-1.5 rounded-full bg-base-300 mt-4 overflow-hidden">
            <div class="h-full bg-primary transition-all duration-1000 ease-linear" id="timer-progress" style="width: 100%;"></div>
          </div>
          
          <div class="mt-2 text-xs font-mono text-base-content/60" id="timer-caption">
            El código se renueva en <span id="segundos-restantes" class="font-bold text-base-content">60</span>s
          </div>

          <button class="btn btn-link btn-xs text-xs text-primary font-medium mt-1 p-0 h-auto" type="button" id="btn-refresh-qr">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            Generar nuevo código QR
          </button>
        </div>

        <!-- Columna Derecha: Instrucciones y Acción -->
        <div class="p-6 sm:p-8 flex flex-col justify-between gap-6">
          <div class="space-y-4">
            <div>
              <h1 class="font-display font-normal text-2xl sm:text-3xl text-base-content tracking-tight">
                Iniciá sesión en esta PC
              </h1>
              <p class="text-xs sm:text-sm text-base-content/70 mt-1 leading-relaxed">
                Escaneá este código QR con la app de Ocicat en tu celular. No necesitás escribir contraseñas en computadoras compartidas.
              </p>
            </div>

            <!-- Pasos 1, 2, 3 -->
            <ol class="space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <span class="size-7 rounded-full bg-primary/10 text-primary border border-primary/30 font-bold text-xs grid place-items-center shrink-0 mt-0.5">
                  1
                </span>
                <div>
                  <strong class="font-semibold text-base-content">Abrí Ocicat en tu celular</strong>
                  <p class="text-xs text-base-content/60">Ingresá a tu app escolar instalada o tu sesión guardada.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="size-7 rounded-full bg-primary/10 text-primary border border-primary/30 font-bold text-xs grid place-items-center shrink-0 mt-0.5">
                  2
                </span>
                <div>
                  <strong class="font-semibold text-base-content">Escaneá este código QR</strong>
                  <p class="text-xs text-base-content/60">Tocá el botón <em>"Escanear QR de PC"</em> en la barra de tu celular.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="size-7 rounded-full bg-primary/10 text-primary border border-primary/30 font-bold text-xs grid place-items-center shrink-0 mt-0.5">
                  3
                </span>
                <div>
                  <strong class="font-semibold text-base-content">Confirmá la conexión</strong>
                  <p class="text-xs text-base-content/60">Aceptá la solicitud <em>"¿Conectar con esta PC?"</em> en tu pantalla.</p>
                </div>
              </li>
            </ol>

            <!-- Caja de Estado en Vivo -->
            <div class="p-3.5 rounded-xl border border-info/30 bg-info/10 text-xs text-base-content flex items-center gap-3 transition-all" id="status-live-box">
              <span class="loading loading-spinner loading-xs text-primary shrink-0" id="box-spinner"></span>
              <div id="box-text">
                <strong class="font-semibold text-base-content">Esperando escaneo…</strong>
                <div class="text-[11px] text-base-content/60">Apuntá con la cámara de tu celular al código QR.</div>
              </div>
            </div>
          </div>

          <div>
            <!-- Abrir el flujo del celular (escaneo o ingreso manual del token) -->
            <a
              href="/pwa-pair/"
              target="_blank"
              class="btn btn-outline btn-primary rounded-xl w-full text-xs font-semibold gap-2"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
              Abrir flujo del celular (PWA)
            </a>
          </div>
        </div>

      </div>

      <!-- Pie de Seguridad y Fallback (§13.9.5) -->
      <div class="bg-base-200/60 border-t border-base-300 p-4 sm:px-6 flex flex-wrap justify-between items-center gap-3 text-xs text-base-content/70">
        <div class="flex items-center gap-2">
          <svg class="size-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Sesión temporal (60 min). Se cerrará al cerrar esta pestaña.</span>
        </div>
        <div>
          ¿No tenés tu celular?
          <a href="/login/" class="font-bold text-primary hover:underline ml-1">
            Ingresar con email y magic link en esta PC
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
    import QRCode from 'qrcode';
    import { ApiError, qrStart, qrStatus, type Role } from '../lib/api';

    (() => {
      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T | null;

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2800);
      }

      const POLL_MS = 3000;
      const canvas = $('#qr-canvas') as HTMLCanvasElement | null;
      const timerEl = $('#segundos-restantes');
      const progressEl = $('#timer-progress');
      const statusBox = $('#status-live-box');
      const boxSpinner = $('#box-spinner');
      const boxText = $('#box-text');
      const qrOverlay = $('#qr-overlay');
      const qrOverlayTitle = $('#qr-overlay-title');
      const qrOverlayDesc = $('#qr-overlay-desc');

      // device_label opcional vía ?label= (hostname legible que verá el alumno en el celular)
      const labelParam =
        new URLSearchParams(window.location.search).get('label')?.slice(0, 64) || undefined;

      let pairingId = '';
      let refreshAfter = 60;
      let segRestantes = 60;
      let estado: PairingEstado = 'inicial';
      let pollTimer: ReturnType<typeof setInterval> | null = null;
      let tickTimer: ReturnType<typeof setInterval> | null = null;

      type PairingEstado = 'inicial' | 'waiting' | 'scanned' | 'confirmed';

      function parar() {
        if (pollTimer) clearInterval(pollTimer);
        if (tickTimer) clearInterval(tickTimer);
        pollTimer = null;
        tickTimer = null;
      }

      async function pintarQR(url: string) {
        if (!canvas) return;
        await QRCode.toCanvas(canvas, url, {
          width: 440,
          margin: 1,
          color: { dark: '#111827ff', light: '#ffffffff' },
        });
      }

      function iniciarCuenta() {
        segRestantes = refreshAfter;
        if (progressEl) progressEl.style.width = '100%';
        if (timerEl) timerEl.textContent = String(segRestantes);
        if (tickTimer) clearInterval(tickTimer);
        tickTimer = setInterval(() => {
          segRestantes--;
          if (segRestantes <= 0) {
            // [C3] regeneración ~refresh_after; solo si nadie escaneó todavía
            if (estado === 'waiting' || estado === 'inicial') {
              reiniciar('Código QR renovado por seguridad.');
            }
            return;
          }
          if (timerEl) timerEl.textContent = String(segRestantes);
          if (progressEl) progressEl.style.width = `${(segRestantes / refreshAfter) * 100}%`;
        }, 1000);
      }

      function setEstado(nuevo: PairingEstado, userName?: string) {
        const cambio = nuevo !== estado;
        estado = nuevo;
        if (nuevo === 'waiting') {
          qrOverlay?.classList.add('hidden');
          qrOverlay?.classList.remove('flex');
          if (statusBox) {
            statusBox.className =
              'p-3.5 rounded-xl border border-info/30 bg-info/10 text-xs text-base-content flex items-center gap-3 transition-all';
          }
          if (boxSpinner) boxSpinner.style.display = 'block';
          if (boxText) {
            boxText.innerHTML =
              '<strong class="font-semibold text-base-content">Esperando escaneo…</strong><div class="text-[11px] text-base-content/60">Apuntá con la cámara de tu celular al código QR.</div>';
          }
        } else if (nuevo === 'scanned') {
          qrOverlay?.classList.remove('hidden');
          qrOverlay?.classList.add('flex');
          if (qrOverlayTitle) qrOverlayTitle.textContent = 'Celular detectado';
          if (qrOverlayDesc) qrOverlayDesc.textContent = 'Revisá tu celular para confirmar.';
          if (statusBox) {
            statusBox.className =
              'p-3.5 rounded-xl border border-warning/40 bg-warning/10 text-xs text-base-content flex items-center gap-3 transition-all';
          }
          if (boxSpinner) boxSpinner.style.display = 'block';
          if (boxText) {
            boxText.innerHTML =
              '<strong class="font-semibold">Revisá tu celular…</strong><div class="text-[11px] text-base-content/70">Esperando que confirmes la conexión desde tu teléfono.</div>';
          }
          if (cambio) aviso('¡QR escaneado! Confirmá en tu celular.');
        } else if (nuevo === 'confirmed') {
          parar();
          qrOverlay?.classList.remove('hidden');
          qrOverlay?.classList.add('flex');
          if (qrOverlayTitle) qrOverlayTitle.textContent = '¡Sesión iniciada!';
          if (qrOverlayDesc) qrOverlayDesc.textContent = userName ? `Ingresando como ${userName}…` : 'Ingresando…';
          if (statusBox) {
            statusBox.className =
              'p-3.5 rounded-xl border border-success/40 bg-success/15 text-xs text-base-content flex items-center gap-3 transition-all';
          }
          if (boxSpinner) boxSpinner.style.display = 'none';
          if (boxText) {
            boxText.innerHTML = `<strong class="font-semibold text-success">✅ ¡Conectado${userName ? ` como ${userName}` : ''}!</strong><div class="text-[11px] text-base-content/70">Redirigiendo…</div>`;
          }
          aviso('¡Conexión autorizada con éxito!');
        }
      }

      function destinoPorRol(role: Role): string {
        if (role === 'alumno') return '/mis-salas/';
        if (role === 'docente' || role === 'director') return '/dashboard/';
        return '/';
      }

      function manejarError(err: unknown) {
        if (err instanceof ApiError && err.status === 429) {
          parar();
          const espera = (err.retryAfter ?? 30) * 1000;
          aviso(`${err.message}${err.retryAfter ? ` Reintentamos en ${err.retryAfter}s.` : ''}`);
          setTimeout(reiniciar, espera);
          return;
        }
        if (err instanceof ApiError && err.status === 404) {
          reiniciar(); // pairing inexistente/vencido entre polls → uno nuevo
          return;
        }
        // Red caída o backend ausente: avisar una vez y reintentar
        if (!avisoRedHecho) {
          avisoRedHecho = true;
          aviso(
            err instanceof ApiError
              ? err.message
              : 'Sin conexión con el servidor. Reintentando…',
          );
        }
      }

      let avisoRedHecho = false;

      async function reiniciar(mensaje?: string) {
        parar();
        setEstado('waiting');
        try {
          const start = await qrStart(labelParam);
          pairingId = start.pairing_id;
          refreshAfter = Math.max(5, start.refresh_after || 60);
          await pintarQR(start.qr_url);
          iniciarCuenta();
          if (pollTimer) clearInterval(pollTimer);
          pollTimer = setInterval(consultar, POLL_MS);
          avisoRedHecho = false;
          if (mensaje) aviso(mensaje);
        } catch (err) {
          manejarError(err);
          setTimeout(() => void reiniciar(), 5000);
        }
      }

      async function consultar() {
        try {
          const st = await qrStatus(pairingId);
          if (st.status === 'confirmed') {
            setEstado('confirmed', st.user.name);
            setTimeout(() => {
              window.location.href = destinoPorRol(st.user.role);
            }, 1800);
          } else if (st.status === 'scanned') {
            setEstado('scanned');
            // Congelar regeneración: hay un scan en curso (TTL server-side lo corta)
            if (tickTimer) clearInterval(tickTimer);
            tickTimer = null;
          } else if (st.status === 'expired') {
            reiniciar();
          } else if (st.status === 'denied') {
            reiniciar('Conexión rechazada desde el celular. Generamos un código nuevo.');
          }
        } catch (err) {
          manejarError(err);
        }
      }

      btnRefreshEl()?.addEventListener('click', () => {
        void reiniciar('Nuevo código QR efímero generado.');
      });

      function btnRefreshEl() {
        return document.querySelector('#btn-refresh-qr') as HTMLButtonElement | null;
      }

      void reiniciar();
    })();
  </script>
</Layout>
