---
import Layout from '../../layouts/Layout.astro';
---

<Layout titulo="Entrega" active="entregas">
  <div class="py-6 md:py-10">
    <div class="flex flex-col gap-6">

      <!-- Hero Header -->
      <section class="flex flex-col gap-3">
        <div>
          <a
            href="/consignas/"
            id="link-volver"
            class="inline-flex items-center gap-1.5 text-xs text-base-content/60 hover:text-primary transition-colors font-medium mb-2"
          >
            ← Volver a las consignas
          </a>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-primary" id="consigna-meta">
            Cargando consigna…
          </p>
          <h1 class="font-display font-normal text-3xl md:text-5xl tracking-tight text-base-content mt-1" id="consigna-titulo">
            …
          </h1>
          <p class="text-sm md:text-base text-base-content/65 max-w-2xl mt-1 whitespace-pre-line" id="consigna-instrucciones"></p>
          <div class="flex gap-2 flex-wrap mt-3" id="consigna-adjuntos"></div>
        </div>

        <!-- Stepper (solo alumno) -->
        <div id="stepper-wrap" class="hidden mt-4 pt-4 border-t border-base-300">
          <ul class="steps steps-horizontal w-full" id="wizard-stepper">
            <li class="step step-primary" data-step="1"><span class="text-xs font-semibold">1. Consigna</span></li>
            <li class="step step-primary font-bold" data-step="2"><span class="text-xs font-semibold">2. Archivos</span></li>
            <li class="step" data-step="3"><span class="text-xs font-semibold">3. Entregar</span></li>
          </ul>
        </div>
      </section>

      <!-- ============ VISTA ALUMNO: WIZARD ============ -->
      <section id="vista-alumno" hidden class="flex flex-col gap-6">

        <!-- Estado cerrada (deadline_passed preventivo) -->
        <div id="aviso-cerrada" hidden class="p-4 rounded-xl bg-error/10 border border-error/25 flex items-start gap-2.5 text-sm">
          <svg class="size-5 text-error shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
          <p><strong class="font-bold">La fecha límite pasó y esta consigna no acepta entregas tardías.</strong> Hablá con tu docente si necesitás entregar igual.</p>
        </div>

        <!-- PASO 2: Archivos -->
        <section id="paso-archivos" class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-4">
            <div class="flex flex-wrap justify-between gap-2">
              <div>
                <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Tus archivos</h2>
                <p class="text-xs text-base-content/60 mt-0.5">Arrastrá o elegí los archivos de tu solución. Podés reemplazarlos hasta apretar «Entregar».</p>
              </div>
              <span class="badge badge-outline font-mono text-[11px] uppercase font-bold tracking-wider" id="badge-intento-curso">Intento …</span>
            </div>

            <label
              id="dropzone"
              for="f-archivos"
              class="border-2 border-dashed border-base-300 hover:border-primary hover:bg-primary/5 rounded-2xl p-6 text-center cursor-pointer transition-all flex flex-col items-center gap-2 group"
            >
              <span class="size-10 rounded-full bg-primary/10 text-primary grid place-items-center group-hover:scale-110 transition-transform">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 16V4M7 9l5-5 5 5"></path>
                  <path d="M4 16v3a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 19v-3"></path>
                </svg>
              </span>
              <span class="text-sm font-medium text-base-content">
                Arrastrá hasta acá o <strong class="text-primary font-bold">elegí archivos</strong>
              </span>
              <span class="text-xs text-base-content/50 font-mono">
                .py, .c, .cpp, .txt, .md, .csv, .png, .jpg, .pdf, .zip (hasta 10 MB por archivo)
              </span>
              <input id="f-archivos" type="file" multiple class="hidden"
                     accept=".py,.c,.cpp,.h,.ino,.txt,.md,.csv,.html,.css,.js,.png,.jpg,.jpeg,.pdf,.zip" />
            </label>

            <!-- Lista de archivos subidos en la draft (respuesta del server) -->
            <ul id="lista-archivos" class="flex flex-col gap-2.5 mt-1"></ul>

            <p id="sin-archivos" class="text-xs text-base-content/50">Todavía no subiste nada para este intento.</p>
          </div>
        </section>

        <div id="nav-paso-2" class="flex items-center justify-between gap-4 pt-2">
          <button type="button" id="btn-abrir-consigna" class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content font-medium">
            ← Ver consigna completa
          </button>
          <button type="button" id="btn-continuar-paso3" class="btn btn-primary rounded-xl font-semibold px-8" disabled>
            Continuar →
          </button>
        </div>

        <!-- PASO 3: Resumen + Checkpoint -->
        <section id="paso-final" hidden class="card bg-base-100 border border-base-300 shadow-sm max-w-xl">
          <div class="card-body p-5 md:p-6 gap-4">
            <div>
              <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Resumen de la entrega</h2>
              <p class="text-xs text-base-content/60 mt-0.5">Revisá antes de enviar: los archivos se congelan tal como están.</p>
            </div>

            <dl class="text-xs divide-y divide-base-200">
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Consigna</dt>
                <dd class="font-semibold text-right text-base-content" id="resumen-titulo">—</dd>
              </div>
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Archivos</dt>
                <dd class="font-mono font-medium text-right text-base-content max-w-[60%] break-words" id="resumen-archivos">—</dd>
              </div>
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Intentos</dt>
                <dd class="font-semibold text-right text-warning" id="resumen-intentos">—</dd>
              </div>
            </dl>

            <!-- Sandbox de prueba: CU-5 paso 3 / §5.2 -->
            <div class="p-3.5 rounded-2xl bg-base-200/60 border border-base-300 space-y-2">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-base-content block">Probar en sandbox (opcional)</span>
                  <p class="text-[11px] text-base-content/60">Ejecutá tu solución en el entorno de la consigna antes de entregar.</p>
                </div>
                <button type="button" id="btn-probar-sandbox" class="btn btn-sm btn-outline btn-primary rounded-xl font-semibold shrink-0">
                  ▶ Probar
                </button>
              </div>
              <div id="sandbox-test-status" hidden class="p-2.5 rounded-xl bg-base-100 border border-base-300 text-xs font-mono">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span id="sb-test-badge" class="badge badge-info badge-soft badge-sm font-semibold">iniciando…</span>
                  <span id="sb-test-note" class="text-[10px] text-base-content/50"></span>
                </div>
                <div id="sb-test-logs" class="mockup-code rounded-lg min-h-24 max-h-40 overflow-auto text-[11px] bg-[#070D18] text-[#DCE6F5] p-2 leading-tight">
                  <pre data-prefix=">"><code>Iniciando prueba…</code></pre>
                </div>
              </div>
            </div>

            <div id="zona-entrega" class="flex flex-col sm:flex-row gap-2 mt-1">
              <button type="button" id="btn-entregar" class="btn btn-primary rounded-xl flex-1 font-semibold">
                Quiero entregar
              </button>
              <button type="button" id="btn-volver-editar" class="btn btn-ghost rounded-xl text-base-content/70 font-medium">
                Volver a editar
              </button>
            </div>

            <!-- CHECKPOINT EXPLÍCITO (¿Entregar?) — confirm_attempt del contrato §5.3 -->
            <div id="checkpoint-entrega" hidden class="p-4 rounded-xl bg-warning/15 border border-warning/30 flex flex-col gap-3 mt-2" role="alertdialog" aria-labelledby="checkpoint-title">
              <div class="flex items-start gap-2.5">
                <svg class="size-5 text-warning shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3 2.5 20h19L12 3Z"></path><path d="M12 10v4"></path><path d="M12 17h.01"></path>
                </svg>
                <div class="text-xs text-base-content leading-relaxed">
                  <p id="checkpoint-title" class="font-bold text-sm">¿Entregar?</p>
                  <p class="mt-1 text-base-content/80" id="checkpoint-detalle"></p>
                </div>
              </div>
              <div class="flex justify-end gap-2 pt-1">
                <button type="button" id="btn-cancelar-checkpoint" class="btn btn-ghost btn-xs rounded-lg">
                  No, seguir revisando
                </button>
                <button type="button" id="btn-confirmar-entrega" class="btn btn-primary btn-xs rounded-lg font-bold px-4">
                  Sí, entregar ahora
                </button>
              </div>
            </div>

            <div id="error-409" hidden class="p-4 rounded-xl bg-error/10 border border-error/25 text-xs text-base-content" role="alert"></div>
          </div>
        </section>

        <!-- PANTALLA ÉXITO -->
        <section id="paso-confirmado" hidden class="py-6 flex justify-center">
          <div class="card bg-base-100 border border-base-300 shadow-md max-w-lg w-full text-center">
            <div class="card-body p-6 sm:p-8 flex flex-col items-center gap-4">
              <span class="size-16 rounded-full bg-success/15 text-success grid place-items-center">
                <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 12.5 9.5 17.5 19.5 6.5"></path>
                </svg>
              </span>
              <div>
                <h2 class="font-display font-normal text-4xl tracking-tight text-base-content">¡Entregado!</h2>
                <p class="font-mono text-sm text-base-content/65 mt-1" id="confirm-hora">a las --:--</p>
                <div class="flex gap-2 justify-center mt-2 flex-wrap" id="confirm-flags"></div>
              </div>
              <div class="w-full text-left bg-base-200/60 p-4 rounded-xl border border-base-300 my-2">
                <dl class="text-xs divide-y divide-base-300">
                  <div class="flex justify-between py-2">
                    <dt class="text-base-content/60">Consigna</dt>
                    <dd class="font-semibold text-base-content" id="confirm-consigna">—</dd>
                  </div>
                  <div class="flex justify-between py-2">
                    <dt class="text-base-content/60">Intento</dt>
                    <dd class="font-mono font-bold text-base-content" id="confirm-intento">—</dd>
                  </div>
                  <div class="flex justify-between py-2">
                    <dt class="text-base-content/60">Quedan</dt>
                    <dd class="font-mono font-bold text-base-content" id="confirm-restantes">—</dd>
                  </div>
                </dl>
              </div>
              <button type="button" id="btn-ver-historial-exito" class="btn btn-outline btn-primary rounded-xl w-full font-semibold">
                Ver mis intentos
              </button>
            </div>
          </div>
        </section>

        <!-- HISTORIAL /me -->
        <section id="historial" hidden class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-3">
            <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Mis intentos</h2>
            <ul id="historial-lista" class="flex flex-col divide-y divide-base-200"></ul>
            <p id="historial-vacio" class="text-xs text-base-content/50">Tus entregas de esta consigna van a aparecer acá.</p>
          </div>
        </section>
      </section>

      <!-- ============ VISTA DOCENTE: CORRECCIÓN ============ -->
      <section id="vista-docente" hidden class="flex flex-col gap-6">
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5" id="stats-cards"></div>

        <div class="flex gap-2 flex-wrap" role="group" aria-label="Filtrar entregas" id="tabs-filtro">
          <button type="button" data-filter="" class="btn btn-sm rounded-full bg-neutral text-neutral-content border-transparent">Todas</button>
          <button type="button" data-filter="late" class="btn btn-sm rounded-full bg-base-100 border-base-300 hover:border-base-content">Tardías</button>
          <button type="button" data-filter="missing" class="btn btn-sm rounded-full bg-base-100 border-base-300 hover:border-base-content">Sin entregar</button>
          <button type="button" data-filter="error" class="btn btn-sm rounded-full bg-base-100 border-base-300 hover:border-base-content">Con error</button>
        </div>

        <div class="flex flex-col divide-y divide-base-300 bg-base-100 rounded-2xl border border-base-300 overflow-hidden shadow-xs" id="lista-submissions">
          <p class="p-6 text-sm text-base-content/60 text-center">Cargando entregas…</p>
        </div>
      </section>

      <!-- Sin acceso / error -->
      <section id="vista-error" hidden class="py-10 text-center">
        <h2 class="font-display font-normal text-2xl text-base-content" id="error-titulo">No pudimos cargar esta entrega</h2>
        <p class="text-sm text-base-content/60 mt-1 mb-4" id="error-texto"></p>
        <a href="/mis-salas/" class="btn btn-primary rounded-full px-6">Volver</a>
      </section>
    </div>
  </div>

  <!-- Modal consigna completa -->
  <dialog id="modal-consigna" class="modal">
    <div class="modal-box max-w-2xl bg-base-100 border border-base-300">
      <h3 class="font-display text-2xl font-normal text-base-content" id="modal-titulo">…</h3>
      <p class="py-2 text-xs text-base-content/60 font-mono" id="modal-meta"></p>
      <div class="divider my-2"></div>
      <div class="text-sm text-base-content/80 whitespace-pre-line" id="modal-cuerpo"></div>
      <div class="modal-action">
        <form method="dialog"><button class="btn btn-sm btn-primary rounded-xl">Entendido</button></form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>cerrar</button></form>
  </dialog>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
      import {
        ApiError, assignmentStats, createSandbox, deliverSubmission, getAssignment, listSubmissionsFiltered,
        me, mySubmissions, streamRunLogs, uploadSubmissionFiles,
        type Assignment, type Submission, type SubmissionFile,
      } from '../../lib/api';

    (() => {
      const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T | null;

      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 3200);
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      }

      const assignmentId = new URLSearchParams(window.location.search).get('id') ?? '';

      const RUNTIME_LABEL: Record<string, string> = { python: 'Python', web: 'Web', cpp: 'C++', arduino: 'Arduino' };

      let consigna: Assignment | null = null;
      let draftId: string | null = null;
      /** Intento N que el alumno vio en pantalla → confirm_attempt (§5.3). */
      let intentoEnCurso = 0;
      /** 0 = sin límite. */
      let maxIntentos = 0;
      let usados = 0;

      function textoVencimiento(a: Assignment): { texto: string; vencida: boolean } {
        if (!a.due_at) return { texto: 'Sin fecha límite · práctica continua', vencida: false };
        const d = new Date(a.due_at);
        const vencida = d.getTime() < Date.now();
        const f = d.toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });
        const h = d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
        return {
          texto: vencida ? `Venció el ${f} · ${h}` : `Vence el ${f} · ${h}`,
          vencida,
        };
      }

      function pesoLegible(bytes: number): string {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return Math.round(bytes / 1024) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
      }

      function pintarHeader(a: Assignment) {
        const ven = textoVencimiento(a);
        $('#consigna-titulo')!.textContent = a.title;
        $('#consigna-instrucciones')!.textContent = a.instructions ?? '';
        $('#consigna-meta')!.textContent =
          `${RUNTIME_LABEL[a.runtime] ?? a.runtime} · ${ven.texto}`;
        $('#modal-titulo')!.textContent = a.title;
        $('#modal-meta')!.textContent = `Runtime: ${RUNTIME_LABEL[a.runtime] ?? a.runtime} · ${ven.texto}`;
        $('#modal-cuerpo')!.textContent = a.instructions ?? '(Sin instrucciones)';
        const adj = $('#consigna-adjuntos')!;
        adj.innerHTML = (a.attachments ?? [])
          .map(
            (x) =>
              `<span class="badge badge-outline gap-1.5 py-3 px-3 text-xs font-mono">📄 ${escapeHtml(x.filename)} (${pesoLegible(x.size_bytes)})</span>`,
          )
          .join('');
      }

      // --- Wizard alumno ---

      function refrescarIntento(historial: Submission[]) {
        usados = historial.filter((s) => s.state === 'delivered').length;
        if (consigna?.attempts.mode === 'one') maxIntentos = 1;
        else if (consigna?.attempts.mode === 'limited') maxIntentos = consigna.attempts.max;
        else maxIntentos = 0;
        intentoEnCurso = usados + 1;

        const label = $('#badge-intento-curso')!;
        label.textContent = maxIntentos === 0
          ? `Intento ${intentoEnCurso} · ilimitados`
          : `Intento ${intentoEnCurso} de ${maxIntentos}`;

        $('#resumen-intentos')!.textContent = maxIntentos === 0
          ? `Intento ${intentoEnCurso} · sin límite`
          : `Intento ${intentoEnCurso} de ${maxIntentos}`;
      }

      function pintarArchivos(files: SubmissionFile[]) {
        const ul = $('#lista-archivos')!;
        $('#sin-archivos')?.classList.toggle('hidden', files.length > 0);
        ($('#btn-continuar-paso3') as HTMLButtonElement).disabled = files.length === 0;
        ul.innerHTML = files
          .map(
            (f) => `
        <li class="flex items-center justify-between gap-3 p-3 rounded-xl bg-base-200/60 border border-base-300">
          <div class="flex items-center gap-3 min-w-0">
            <span class="size-10 rounded-xl bg-primary/10 text-primary font-mono font-bold text-[10px] grid place-items-center shrink-0">${escapeHtml((f.name.split('.').pop() ?? '?').slice(0, 3).toUpperCase())}</span>
            <div class="min-w-0">
              <span class="block font-mono text-xs font-semibold text-base-content truncate">${escapeHtml(f.name)}</span>
              <span class="block text-[11px] text-base-content/55">${pesoLegible(f.size)}</span>
            </div>
          </div>
          <span class="badge badge-success badge-soft badge-sm shrink-0">subido</span>
        </li>`,
          )
          .join('');
        $('#resumen-archivos')!.textContent = files.map((f) => f.name).join(', ') || '—';
      }

      async function subirArchivos(files: File[]) {
        if (!files.length || !assignmentId) return;
        const dz = $('#dropzone')!;
        dz.classList.add('pointer-events-none', 'opacity-60');
        try {
          const sub = await uploadSubmissionFiles(assignmentId, files);
          draftId = sub.id;
          pintarArchivos(sub.files ?? []);
          aviso(sub.files?.length === 1 ? 'Archivo listo para este intento.' : `${sub.files?.length ?? 0} archivos listos para este intento.`);
        } catch (err) {
          aviso(err instanceof ApiError && err.message ? err.message : 'No pudimos subir los archivos.');
        } finally {
          dz.classList.remove('pointer-events-none', 'opacity-60');
        }
      }

      function setStepper(n: number) {
        document.querySelectorAll('#wizard-stepper .step').forEach((s, idx) => s.classList.toggle('step-primary', idx < n));
      }

      function mostrarError409(code: string): void {
        const box = $('#error-409')!;
        const copy: Record<string, string> = {
          attempt_conflict:
            'La configuración de esta consigna cambió mientras preparabas tu entrega (o hubo otro intento). Actualizamos tus datos: revisá el intento actual y volvé a confirmar.',
          attempts_exhausted:
            'Te quedaste sin intentos según la configuración vigente de la consigna. Hablá con tu docente si necesitás uno más.',
          deadline_passed:
            'La fecha límite pasó y esta consigna no acepta entregas tardías.',
        };
        box.textContent = copy[code] ?? 'No pudimos entregar. Revisá el estado e intentá de nuevo.';
        box.hidden = false;
      }

      async function refrescarWizard() {
        if (!assignmentId) return;
        const [a, historial] = await Promise.all([
          getAssignment(assignmentId),
          mySubmissions(assignmentId).catch(() => [] as Submission[]),
        ]);
        consigna = a;
        draftId = null;
        pintarHeader(a);
        refrescarIntento(historial);
        pintarHistorial(historial);

        // Cerrada para tardías → bloquear flujo
        const ven = textoVencimiento(a);
        const cerrada = ven.vencida && a.late_policy === 'closed';
        $('#aviso-cerrada')!.hidden = !cerrada;
        ($('#f-archivos') as HTMLInputElement).disabled = cerrada;
        ($('#btn-continuar-paso3') as HTMLButtonElement).disabled = cerrada;
        if (cerrada) $('#dropzone')!.classList.add('pointer-events-none', 'opacity-50');
      }

      function pintarHistorial(historial: Submission[]) {
        const sec = $('#historial')!;
        const ul = $('#historial-lista')!;
        sec.hidden = historial.length === 0 && !draftId;
        $('#historial-vacio')!.classList.toggle('hidden', historial.length > 0);
        ul.innerHTML = [...historial]
          .sort((x, y) => y.attempt_number - x.attempt_number)
          .map((s) => {
            const flags = [
              s.late ? '<span class="badge badge-warning badge-soft badge-sm">tardía</span>' : '',
              s.tested_ok ? '<span class="badge badge-success badge-soft badge-sm">probado OK</span>' : '',
              s.test_error ? '<span class="badge badge-error badge-soft badge-sm">error al probar</span>' : '',
            ].filter(Boolean).join(' ');
            const cuando = s.delivered_at
              ? new Date(s.delivered_at).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
              : '';
            return `
          <li class="py-3 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <b class="font-mono text-sm">#${s.attempt_number}</b>
              <span class="ml-2 text-xs ${s.state === 'delivered' ? 'text-success font-semibold' : 'text-base-content/60'}">${s.state === 'delivered' ? 'Entregada' : 'Borrador'}</span>
              <span class="block text-[11px] text-base-content/55">${cuando}</span>
            </div>
            <div class="flex gap-1.5 shrink-0">${flags}</div>
          </li>`;
          })
          .join('');
      }

      async function initAlumno() {
        $('#vista-alumno')!.hidden = false;
        $('#stepper-wrap')!.classList.remove('hidden');
        try {
          await refrescarWizard();
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          $('#vista-alumno')!.hidden = true;
          $('#vista-error')!.hidden = false;
          $('#error-texto')!.textContent = err instanceof ApiError && err.message ? err.message : 'Intentá de nuevo más tarde.';
        }
      }

      // Dropzone alumno
      const dropzone = $('#dropzone')!;
      ['dragenter', 'dragover'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-primary', 'bg-primary/5');
        }),
      );
      ['dragleave', 'drop'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-primary', 'bg-primary/5');
        }),
      );
      dropzone.addEventListener('drop', (e) => {
        if (e.dataTransfer?.files.length) void subirArchivos(Array.from(e.dataTransfer.files));
      });
      $('#f-archivos').addEventListener('change', function (this: HTMLInputElement) {
        if (this.files?.length) void subirArchivos(Array.from(this.files));
        this.value = '';
      });

      // Navegación pasos
      $('#btn-abrir-consigna').addEventListener('click', () => ($('#modal-consigna') as HTMLDialogElement).showModal());

      $('#btn-continuar-paso3').addEventListener('click', () => {
        $('#resumen-titulo')!.textContent = consigna?.title ?? '—';
        $('#paso-archivos').hidden = true;
        $('#nav-paso-2').hidden = true;
        $('#paso-final').hidden = false;
        setStepper(3);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      $('#btn-volver-editar').addEventListener('click', () => {
        $('#paso-final').hidden = true;
        $('#paso-archivos').hidden = false;
        $('#nav-paso-2').hidden = false;
        setStepper(2);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Probar en sandbox (CU-5 paso 3 / §5.2)
      let testEventSource: EventSource | null = null;

      function mapearRuntimeATemplate(rt: string): string {
        const map: Record<string, string> = {
          python: 'python/numpy',
          web: 'bun/react',
          cpp: 'cpp/sqlite',
          arduino: 'arduino',
        };
        return map[rt] ?? 'python/numpy';
      }

      $('#btn-probar-sandbox')?.addEventListener('click', async () => {
        if (!draftId) {
          aviso('Subí tus archivos antes de probar.');
          return;
        }
        const btn = $('#btn-probar-sandbox') as HTMLButtonElement;
        const testStatusWrap = $('#sandbox-test-status')!;
        const testBadge = $('#sb-test-badge')!;
        const testLogs = $('#sb-test-logs')!;
        const testNote = $('#sb-test-note')!;

        btn.disabled = true;
        btn.textContent = 'Probando…';
        testStatusWrap.hidden = false;
        testBadge.className = 'badge badge-info badge-soft badge-sm font-semibold';
        testBadge.textContent = 'iniciando…';
        testLogs.innerHTML = '<pre data-prefix=">"><code>Iniciando prueba en sandbox…</code></pre>';
        testNote.textContent = '';

        if (testEventSource) {
          testEventSource.close();
          testEventSource = null;
        }

        try {
          const tplId = mapearRuntimeATemplate(consigna?.runtime ?? 'python');
          const res = await createSandbox({
            template_id: tplId,
            purpose: 'submission_test',
            submission_id: draftId,
            retention: 'ephemeral',
          });

          if (res.status === 'queued') {
            testBadge.className = 'badge badge-warning badge-soft badge-sm font-semibold';
            testBadge.textContent = `en cola (pos ${res.queue_position ?? 1})`;
            testNote.textContent = res.budget_note ?? '';
          }

          testEventSource = streamRunLogs(res.run_id, {
            onLog: (l) => {
              const pre = document.createElement('pre');
              pre.setAttribute('data-prefix', l.stream === 'stdout' ? '>' : '!');
              if (l.stream === 'stderr') pre.classList.add('text-error');
              pre.innerHTML = `<code>${escapeHtml(l.line)}</code>`;
              testLogs.appendChild(pre);
              testLogs.scrollTop = testLogs.scrollHeight;
            },
            onStatus: (st) => {
              testBadge.textContent = st.status;
            },
            onExit: (exit) => {
              if (exit.exit_code === 0) {
                testBadge.className = 'badge badge-success badge-soft badge-sm font-semibold';
                testBadge.textContent = 'probado OK (exit 0)';
                aviso('Prueba completada: exit 0 ✓');
              } else {
                testBadge.className = 'badge badge-error badge-soft badge-sm font-semibold';
                testBadge.textContent = `error (exit ${exit.exit_code})`;
                aviso(`Prueba finalizada con código de error ${exit.exit_code}`);
              }
              btn.disabled = false;
              btn.textContent = '▶ Probar de nuevo';
            },
            onError: () => {
              testEventSource?.close();
              testEventSource = null;
              btn.disabled = false;
              btn.textContent = '▶ Probar de nuevo';
            },
          });
        } catch (err) {
          btn.disabled = false;
          btn.textContent = '▶ Probar';
          if (err instanceof ApiError && (err.code === 'capacity_unavailable' || err.status === 503)) {
            testBadge.className = 'badge badge-error badge-soft badge-sm font-semibold';
            testBadge.textContent = 'servidor ocupado';
            aviso('Servidor sin capacidad: la cola de sandboxes está llena. Esperá unos minutos e intentá de nuevo.');
          } else {
            testBadge.className = 'badge badge-error badge-soft badge-sm font-semibold';
            testBadge.textContent = 'error';
            aviso(err instanceof ApiError && err.message ? err.message : 'No pudimos probar en sandbox.');
          }
        }
      });

      // Checkpoint explícito
      const zonaEntrega = $('#zona-entrega')!;
      const checkpoint = $('#checkpoint-entrega')!;

      $('#btn-entregar').addEventListener('click', () => {
        const sinLimite = maxIntentos === 0;
        const quedan = sinLimite ? 'infinitos' : String(maxIntentos - intentoEnCurso);
        $('#checkpoint-title')!.textContent = `¿Entregar? (intento ${intentoEnCurso} de ${sinLimite ? '∞' : maxIntentos})`;
        $('#checkpoint-detalle')!.textContent =
          !sinLimite && maxIntentos - intentoEnCurso === 0
            ? 'Este es tu último intento: después no vas a poder volver a entregar, y los archivos se congelan tal como están ahora.'
            : `Después te quedan ${quedan} intento${quedan === '1' ? '' : 's'}, y los archivos se congelan tal como están ahora.`;
        zonaEntrega.hidden = true;
        checkpoint.hidden = false;
        $('#error-409')!.hidden = true;
        ($('#btn-confirmar-entrega') as HTMLButtonElement).focus();
      });

      $('#btn-cancelar-checkpoint').addEventListener('click', () => {
        checkpoint.hidden = true;
        zonaEntrega.hidden = false;
        ($('#btn-entregar') as HTMLButtonElement).focus();
      });

      $('#btn-confirmar-entrega').addEventListener('click', async () => {
        if (!draftId) {
          aviso('Subí al menos un archivo antes de entregar.');
          return;
        }
        const btn = $('#btn-confirmar-entrega') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Entregando…';
        try {
          const sub = await deliverSubmission(draftId, intentoEnCurso);
          // Éxito
          const d = sub.delivered_at ? new Date(sub.delivered_at) : new Date();
          $('#confirm-hora')!.textContent = `a las ${d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })} del ${d.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' })}`;
          $('#confirm-consigna')!.textContent = consigna?.title ?? '—';
          $('#confirm-intento')!.textContent = `#${sub.attempt_number}${maxIntentos === 0 ? '' : ` de ${maxIntentos}`}`;
          $('#confirm-restantes')!.textContent = maxIntentos === 0 ? 'ilimitados' : String(sub.attempts_remaining ?? Math.max(maxIntentos - sub.attempt_number, 0));
          $('#confirm-flags')!.innerHTML = [
            sub.late ? '<span class="badge badge-warning badge-soft font-semibold text-[10px] uppercase tracking-wider">Entrega tardía</span>' : '',
            sub.tested_ok ? '<span class="badge badge-success badge-soft font-semibold text-[10px] uppercase tracking-wider">Probada OK</span>' : '',
            sub.test_error ? '<span class="badge badge-error badge-soft font-semibold text-[10px] uppercase tracking-wider">Error en pruebas</span>' : '',
          ].filter(Boolean).join('');

          $('#paso-archivos').hidden = true;
          $('#nav-paso-2').hidden = true;
          $('#paso-final').hidden = true;
          $('#paso-confirmado').hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
          aviso('¡Entrega enviada!');
        } catch (err) {
          if (!(err instanceof ApiError)) {
            aviso('No pudimos conectar con el servidor.');
            btn.disabled = false;
            btn.textContent = 'Sí, entregar ahora';
            return;
          }
          if (err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          if (err.status === 409) {
            checkpoint.hidden = true;
            zonaEntrega.hidden = false;
            mostrarError409(err.code);
            if (err.code === 'attempt_conflict') {
              // El contrato manda a refrescar el estado del cliente
              await refrescarWizard();
            }
            btn.disabled = false;
            btn.textContent = 'Sí, entregar ahora';
            return;
          }
          aviso(err.message || 'No pudimos entregar.');
          btn.disabled = false;
          btn.textContent = 'Sí, entregar ahora';
        }
      });

      $('#btn-ver-historial-exito').addEventListener('click', () => {
        $('#paso-confirmado').hidden = true;
        void mySubmissions(assignmentId).then((h) => {
          pintarHistorial(h);
          refrescarIntento(h);
          $('#historial')!.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // --- Corrección docente ---
      function statCard(label: string, valor: number, color: string): string {
        return `
        <div class="bg-base-100 border border-base-300 rounded-xl p-3 text-center">
          <span class="font-mono font-bold text-xl ${color} block leading-none">${valor}</span>
          <span class="text-[10px] uppercase font-bold tracking-wider text-base-content/50 block mt-1">${label}</span>
        </div>`;
      }

      function filaSubmission(s: Submission): string {
        const flags = [
          s.late ? '<span class="badge badge-warning badge-soft badge-sm">tardía</span>' : '',
          s.tested_ok ? '<span class="badge badge-success badge-soft badge-sm">OK</span>' : '',
          s.test_error ? '<span class="badge badge-error badge-soft badge-sm">error</span>' : '',
        ].filter(Boolean).join(' ');
        const cuando = s.delivered_at
          ? new Date(s.delivered_at).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
          : '';
        return `
        <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-base-200/40 transition-colors">
          <div class="flex items-center gap-3 min-w-0">
            <span class="font-mono font-bold text-sm text-base-content/70 shrink-0">#${s.attempt_number}</span>
            <div class="min-w-0">
              <span class="block text-sm font-semibold truncate">${escapeHtml(s.student_name ?? 'Estudiante')}</span>
              <span class="block text-[11px] text-base-content/55">${cuando}${s.files?.length ? ` · ${(s.files.length)} archivo${s.files.length === 1 ? '' : 's'}` : ''}</span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            ${flags}
            <span class="badge ${s.state === 'delivered' ? 'badge-primary badge-soft' : 'badge-ghost'} badge-sm">${s.state === 'delivered' ? 'entregada' : 'borrador'}</span>
          </div>
        </div>`;
      }

      async function cargarFiltroDocente(filter: string) {
        const lista = $('#lista-submissions')!;
        lista.innerHTML = '<p class="p-6 text-sm text-base-content/60 text-center">Cargando entregas…</p>';
        try {
          const subs = filter
            ? await listSubmissionsFiltered(assignmentId, filter as 'late' | 'missing' | 'error')
            : await listSubmissionsFiltered(assignmentId, undefined);
          lista.innerHTML = subs.length
            ? subs.map(filaSubmission).join('')
            : `<p class="p-6 text-sm text-base-content/60 text-center">Nadie entra en «${escapeHtml(filter)}».</p>`;
        } catch (err) {
          lista.innerHTML = `<p class="p-6 text-sm text-base-content/60 text-center">${escapeHtml(err instanceof ApiError && err.message ? err.message : 'No pudimos cargar las entregas.')}</p>`;
        }
      }

      async function initDocente() {
        $('#vista-docente')!.hidden = false;
        try {
          const [a, stats] = await Promise.all([getAssignment(assignmentId), assignmentStats(assignmentId)]);
          consigna = a;
          pintarHeader(a);
          $('#link-volver')!.href = `/consignas/?classroom=${encodeURIComponent(a.classroom_id ?? '')}`;
          $('#stats-cards')!.innerHTML =
            statCard('alumnos', stats.total_students, 'text-base-content') +
            statCard('entregadas', stats.delivered, 'text-base-content') +
            statCard('ok', stats.tested_ok, 'text-primary') +
            statCard('error', stats.test_errors, 'text-error') +
            statCard('tardías', stats.late, 'text-warning') +
            statCard('sin entregar', stats.missing, 'text-base-content/60');
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          $('#vista-docente')!.hidden = true;
          $('#vista-error')!.hidden = false;
          $('#error-texto')!.textContent = err instanceof ApiError && err.message ? err.message : 'Intentá de nuevo más tarde.';
          return;
        }
        await cargarFiltroDocente('');
      }

      $('#tabs-filtro')?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!btn) return;
        document.querySelectorAll<HTMLButtonElement>('#tabs-filtro [data-filter]').forEach((b) => {
          b.className = `btn btn-sm rounded-full ${
            b === btn ? 'bg-neutral text-neutral-content border-transparent' : 'bg-base-100 border-base-300 hover:border-base-content'
          }`;
        });
        void cargarFiltroDocente(btn.dataset.filter ?? '');
      });

      // --- Init común ---
      async function init() {
        if (!assignmentId) {
          $('#vista-error')!.hidden = false;
          $('#error-texto')!.textContent = 'Falta la consigna: entrá desde el listado.';
          return;
        }
        try {
          const yo = await me();
          if (yo.role === 'alumno') await initAlumno();
          else if (yo.role === 'docente' || yo.role === 'director') await initDocente();
          else {
            window.location.href = '/login/';
          }
        } catch {
          window.location.href = '/login/';
        }
      }

      void init();
    })();
  </script>
</Layout>
