---
import Layout from '../../layouts/Layout.astro';
import { consignas, salas } from '../../data/mock';

export function getStaticPaths() {
  return consignas.map((consigna) => ({
    params: { id: consigna.id },
    props: { consigna },
  }));
}

interface Props {
  consigna: (typeof consignas)[number];
}

const { consigna } = Astro.props;
const sala = salas.find((s) => s.id === consigna.salaId) || salas[0];
---

<Layout titulo={`Entregar ${consigna.titulo}`} active="entregas" navRole="alumno">
  <div class="py-6 md:py-10">
    <div class="flex flex-col gap-6">

      <!-- Hero Header -->
      <section class="flex flex-col gap-3">
        <div>
          <a
            href={`/consignas/?sala=${sala.codigo.toLowerCase()}`}
            class="inline-flex items-center gap-1.5 text-xs text-base-content/60 hover:text-primary transition-colors font-medium mb-2"
          >
            ← {sala.nombre} · {sala.curso}
          </a>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-primary">
            {sala.nombre} · {sala.curso} · {consigna.vence}
          </p>
          <h1 class="font-display font-normal text-3xl md:text-5xl tracking-tight text-base-content mt-1" id="titulo-consigna">
            {consigna.titulo}
          </h1>
          <p class="text-sm md:text-base text-base-content/65 max-w-2xl mt-1">
            {consigna.descripcion}
          </p>
        </div>

        <!-- Stepper (3 pasos) -->
        <div class="mt-4 pt-4 border-t border-base-300">
          <ul class="steps steps-horizontal w-full" id="wizard-stepper">
            <li class="step step-primary" data-step="1">
              <span class="text-xs font-semibold">1. Consigna</span>
            </li>
            <li class="step step-primary font-bold" data-step="2">
              <span class="text-xs font-semibold">2. Archivos y entorno</span>
            </li>
            <li class="step" data-step="3">
              <span class="text-xs font-semibold">3. Probar y entregar</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- PASO 1: Consigna Detallada (modal / sección colapsable) -->
      <dialog id="modal-consigna" class="modal">
        <div class="modal-box max-w-2xl bg-base-100 border border-base-300">
          <h3 class="font-display text-2xl font-normal text-base-content">{consigna.titulo}</h3>
          <p class="py-2 text-xs text-base-content/60 font-mono">Runtime requerido: {consigna.runtime} · {consigna.vence}</p>

          <div class="divider my-2"></div>

          <div class="text-sm text-base-content/80 flex flex-col gap-3">
            <p>{consigna.descripcion}</p>
            {consigna.instrucciones && (
              <div class="flex flex-col gap-1.5 mt-2">
                <span class="font-bold text-xs uppercase tracking-wider text-base-content">Instrucciones:</span>
                <ul class="list-disc list-inside text-xs space-y-1 text-base-content/70">
                  {consigna.instrucciones.map((inst) => (
                    <li>{inst}</li>
                  ))}
                </ul>
              </div>
            )}
            {consigna.archivosAdjuntos && (
              <div class="flex flex-col gap-1.5 mt-2">
                <span class="font-bold text-xs uppercase tracking-wider text-base-content">Material adjunto:</span>
                <div class="flex gap-2 flex-wrap">
                  {consigna.archivosAdjuntos.map((adj) => (
                    <span class="badge badge-outline gap-1.5 py-3 px-3 text-xs font-mono">
                      📄 {adj.nombre} ({adj.tamano})
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="modal-action">
            <form method="dialog">
              <button class="btn btn-sm btn-primary rounded-xl">Entendido</button>
            </form>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>cerrar</button>
        </form>
      </dialog>

      <!-- PASO 2: Archivos y Entorno -->
      <section id="paso-archivos" class="grid lg:grid-cols-[1.1fr_0.9fr] gap-6">

        <!-- Panel Izquierdo: Tus archivos -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-4">
            <div>
              <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Tus archivos</h2>
              <p class="text-xs text-base-content/60 mt-0.5">Arrastrá o elegí los archivos de tu solución.</p>
            </div>

            <!-- Dropzone -->
            <label
              id="dropzone"
              for="f-archivos"
              class="border-2 border-dashed border-base-300 hover:border-primary hover:bg-primary/5 rounded-2xl p-6 text-center cursor-pointer transition-all flex flex-col items-center gap-2 group"
            >
              <span class="size-10 rounded-full bg-primary/10 text-primary grid place-items-center group-hover:scale-110 transition-transform">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 16V4M7 9l5-5 5 5"></path>
                  <path d="M4 16v3a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 19v-3"></path>
                </svg>
              </span>
              <span class="text-sm font-medium text-base-content">
                Arrastrá hasta acá o <strong class="text-primary font-bold">elegí archivos</strong>
              </span>
              <span class="text-xs text-base-content/50 font-mono">
                .py, .c, .cpp, .txt, .md, .png, .zip (hasta 10 MB)
              </span>
              <input
                id="f-archivos"
                type="file"
                multiple
                class="hidden"
                accept=".py,.c,.cpp,.h,.txt,.md,.csv,.png,.jpg,.pdf,.zip"
              />
            </label>

            <!-- Lista de archivos -->
            <ul id="lista-archivos" class="flex flex-col gap-2.5 mt-1">
              <li class="flex items-center justify-between gap-3 p-3 rounded-xl bg-base-200/60 border border-base-300 archivo-item" data-nombre="tarea.py">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="size-10 rounded-xl bg-primary/10 text-primary font-mono font-bold text-xs grid place-items-center shrink-0">
                    PY
                  </span>
                  <div class="min-w-0">
                    <span class="block font-mono text-xs font-semibold text-base-content truncate archivo-nombre">tarea.py</span>
                    <span class="block text-[11px] text-base-content/55">1,8 KB · solución principal</span>
                  </div>
                </div>
                <button type="button" class="btn btn-ghost btn-xs text-error hover:bg-error/10 rounded-lg btn-quitar-archivo">
                  Quitar
                </button>
              </li>

              <li class="flex items-center justify-between gap-3 p-3 rounded-xl bg-base-200/60 border border-base-300 archivo-item" data-nombre="captura-tests.png">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="size-10 rounded-xl bg-primary/10 text-primary font-mono font-bold text-xs grid place-items-center shrink-0">
                    PNG
                  </span>
                  <div class="min-w-0">
                    <span class="block font-mono text-xs font-semibold text-base-content truncate archivo-nombre">captura-tests.png</span>
                    <span class="block text-[11px] text-base-content/55">84 KB · captura de pruebas locales</span>
                  </div>
                </div>
                <button type="button" class="btn btn-ghost btn-xs text-error hover:bg-error/10 rounded-lg btn-quitar-archivo">
                  Quitar
                </button>
              </li>

              <li class="flex items-center justify-between gap-3 p-3 rounded-xl bg-base-200/60 border border-base-300 archivo-item" data-nombre="README.md">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="size-10 rounded-xl bg-primary/10 text-primary font-mono font-bold text-xs grid place-items-center shrink-0">
                    MD
                  </span>
                  <div class="min-w-0">
                    <span class="block font-mono text-xs font-semibold text-base-content truncate archivo-nombre">README.md</span>
                    <span class="block text-[11px] text-base-content/55">0,4 KB · documentación</span>
                  </div>
                </div>
                <button type="button" class="btn btn-ghost btn-xs text-error hover:bg-error/10 rounded-lg btn-quitar-archivo">
                  Quitar
                </button>
              </li>
            </ul>

            <p class="text-xs text-base-content/50">
              Podés reemplazar archivos las veces que quieras hasta apretar «Entregar».
            </p>
          </div>
        </div>

        <!-- Panel Derecho: Tu entorno -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-5">
            <div>
              <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Tu entorno</h2>
              <p class="text-xs text-base-content/60 mt-0.5">Elegí con qué lenguaje corre tu trabajo.</p>
            </div>

            <!-- Selector de Lenguajes -->
            <div class="flex flex-wrap gap-2.5" role="group" aria-label="Lenguaje de ejecución" id="selector-lenguaje">
              <button
                type="button"
                data-leng="Python"
                class="btn btn-sm md:btn-md rounded-full font-semibold leng-chip btn-primary"
                aria-pressed="true"
              >
                <span class="size-5 rounded-full bg-base-100/20 text-xs grid place-items-center font-mono mr-1">PY</span>
                Python
              </button>
              <button
                type="button"
                data-leng="Web"
                class="btn btn-sm md:btn-md rounded-full font-semibold leng-chip btn-outline btn-primary"
                aria-pressed="false"
              >
                <span class="size-5 rounded-full bg-primary/10 text-xs grid place-items-center font-mono mr-1">&lt;/&gt;</span>
                Web
              </button>
              <button
                type="button"
                data-leng="C++"
                class="btn btn-sm md:btn-md rounded-full font-semibold leng-chip btn-outline btn-primary"
                aria-pressed="false"
              >
                <span class="size-5 rounded-full bg-primary/10 text-xs grid place-items-center font-mono mr-1">C++</span>
                C++
              </button>
              <button
                type="button"
                data-leng="Arduino"
                class="btn btn-sm md:btn-md rounded-full font-semibold leng-chip btn-outline btn-primary"
                aria-pressed="false"
              >
                <span class="size-5 rounded-full bg-primary/10 text-xs grid place-items-center font-mono mr-1">ARD</span>
                Arduino
              </button>
            </div>

            <!-- Paquetes Extra -->
            <div class="form-control flex flex-col gap-1.5">
              <label for="f-paquetes" class="text-xs font-bold uppercase tracking-wider text-base-content/70">
                Paquetes extra (opcional)
              </label>
              <input
                id="f-paquetes"
                type="text"
                placeholder="ej.: numpy, pandas"
                autocomplete="off"
                spellcheck="false"
                class="input input-bordered w-full rounded-xl font-mono text-sm bg-base-200/60 focus:bg-base-100 focus:border-primary"
              />
              <p class="text-[11px] text-base-content/50">
                Separados por coma. Se instalan automáticamente al probar o entregar.
              </p>
            </div>

            <div class="mt-auto pt-3 border-t border-base-200 text-xs text-base-content/60">
              El sandbox de prueba aparece en el siguiente paso: probar no es obligatorio para entregar.
            </div>
          </div>
        </div>

      </section>

      <!-- Botones de Navegación del Paso 2 -->
      <div id="nav-paso-2" class="flex items-center justify-between gap-4 pt-2">
        <button
          type="button"
          id="btn-abrir-consigna"
          class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content font-medium"
        >
          ← Ver consigna completa
        </button>
        <button
          type="button"
          id="btn-continuar-paso3"
          class="btn btn-primary rounded-xl font-semibold px-8"
        >
          Continuar a probar y entregar →
        </button>
      </div>

      <!-- PASO 3: Probar y Entregar (oculto inicialmente) -->
      <section id="paso-final" hidden class="grid lg:grid-cols-[1.1fr_0.9fr] gap-6">

        <!-- Panel Izquierdo: Probar en sandbox -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-4">
            <div class="flex items-center justify-between gap-2">
              <div>
                <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary flex items-center gap-2">
                  Probar en sandbox
                  <span class="badge badge-warning badge-soft text-[10px] uppercase tracking-wider font-bold">Opcional</span>
                </h2>
                <p class="text-xs text-base-content/60 mt-0.5">Corre tu código con los casos de prueba de la consigna.</p>
              </div>
            </div>

            <!-- Terminal Mockup -->
            <div class="rounded-xl overflow-hidden border border-base-300 shadow-md">
              <div class="bg-neutral text-neutral-content px-4 py-2 flex items-center justify-between text-xs font-mono">
                <div class="flex items-center gap-1.5">
                  <span class="size-2.5 rounded-full bg-error inline-block"></span>
                  <span class="size-2.5 rounded-full bg-warning inline-block"></span>
                  <span class="size-2.5 rounded-full bg-success inline-block"></span>
                  <span class="ml-2 opacity-70">sandbox efímero · <span id="term-runtime">python 3.12</span></span>
                </div>
                <span class="text-[11px] text-success font-semibold" id="term-badge">listo</span>
              </div>
              <div
                class="mockup-code rounded-none border-0 min-h-56 max-h-72 overflow-auto text-xs bg-terminal text-terminal-text"
                role="log"
              >
                <pre data-prefix="$"><code>ocicat run tarea.py --tests</code></pre>
                <pre data-prefix=">"><code class="text-base-content/60">levantando sandbox efímero… listo (0,8 s)</code></pre>
                <pre data-prefix=" "><code class="text-success font-semibold">tarea.py compila ................ OK</code></pre>
                <pre data-prefix=" "><code class="text-success">caso 1: lectura de archivo ....... OK</code></pre>
                <pre data-prefix=" "><code class="text-success">caso 2: formato json válido ...... OK</code></pre>
                <pre data-prefix=" "><code class="text-success">caso 3: manejo de excepciones .... OK</code></pre>
                <pre data-prefix=" "><code class="text-success font-bold mt-1">✔ 4 de 4 casos de prueba pasaron</code></pre>
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-2">
              <span class="badge badge-success badge-soft font-mono font-bold text-xs gap-1.5 py-3 px-3.5" id="estado-prueba">
                <i class="size-2 rounded-full bg-success animate-pulse inline-block"></i>
                Prueba exitosa (4/4)
              </span>
              <button
                type="button"
                id="btn-probar"
                class="btn btn-outline btn-primary btn-sm rounded-xl font-semibold gap-2"
              >
                <svg class="size-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
                Probar mi código
              </button>
            </div>
            <p class="text-[11px] text-base-content/50">
              El sandbox es efímero: corre en el server de la escuela y se apaga automáticamente.
            </p>
          </div>
        </div>

        <!-- Panel Derecho: Resumen de la entrega + Checkpoint -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5 md:p-6 gap-4">
            <div>
              <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-primary">Resumen de la entrega</h2>
              <p class="text-xs text-base-content/60 mt-0.5">Revisá los datos antes de enviar.</p>
            </div>

            <dl class="text-xs divide-y divide-base-200">
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Consigna</dt>
                <dd class="font-semibold text-right text-base-content">{consigna.titulo}</dd>
              </div>
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Archivos</dt>
                <dd class="font-mono font-medium text-right text-base-content" id="resumen-archivos">tarea.py, captura-tests.png, README.md</dd>
              </div>
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Entorno</dt>
                <dd class="font-mono font-medium text-right text-base-content" id="resumen-entorno">Python · sin paquetes extra</dd>
              </div>
              <div class="flex justify-between py-2.5">
                <dt class="text-base-content/60">Intentos</dt>
                <dd class="font-semibold text-right text-warning">
                  Intento {consigna.intentosUsados + 1} de {consigna.intentosMax}
                </dd>
              </div>
            </dl>

            <!-- Zona de Botones Principales -->
            <div id="zona-entrega" class="flex flex-col sm:flex-row gap-2 mt-2">
              <button
                type="button"
                id="btn-entregar"
                class="btn btn-primary rounded-xl flex-1 font-semibold"
              >
                Entregar tarea
              </button>
              <button
                type="button"
                id="btn-volver-editar"
                class="btn btn-ghost rounded-xl text-base-content/70 font-medium"
              >
                Volver a editar
              </button>
            </div>

            <!-- CHECKPOINT EXPLÍCITO (¿Entregar?) -->
            <div id="checkpoint-entrega" hidden class="p-4 rounded-xl bg-warning/15 border border-warning/30 flex flex-col gap-3 mt-2" role="alertdialog" aria-labelledby="checkpoint-title">
              <div class="flex items-start gap-2.5">
                <svg class="size-5 text-warning shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3 2.5 20h19L12 3Z"></path>
                  <path d="M12 10v4"></path>
                  <path d="M12 17h.01"></path>
                </svg>
                <div class="text-xs text-base-content leading-relaxed">
                  <p id="checkpoint-title" class="font-bold text-sm">
                    ¿Entregar? (intento {consigna.intentosUsados + 1} de {consigna.intentosMax})
                  </p>
                  <p class="mt-1 text-base-content/80">
                    Después te queda {consigna.intentosMax - consigna.intentosUsados - 1} solo intento, y los archivos se congelan tal como están ahora.
                  </p>
                </div>
              </div>
              <div class="flex justify-end gap-2 pt-1">
                <button type="button" id="btn-cancelar-checkpoint" class="btn btn-ghost btn-xs rounded-lg">
                  No, seguir revisando
                </button>
                <button type="button" id="btn-confirmar-entrega" class="btn btn-primary btn-xs rounded-lg font-bold px-4">
                  Sí, entregar ahora
                </button>
              </div>
            </div>

          </div>
        </div>

      </section>

      <!-- PANTALLA ÉXITO: Entregado ✓ -->
      <section id="paso-confirmado" hidden class="py-6 flex justify-center">
        <div class="card bg-base-100 border border-base-300 shadow-md max-w-lg w-full text-center">
          <div class="card-body p-6 sm:p-8 flex flex-col items-center gap-4">
            <span class="size-16 rounded-full bg-success/15 text-success grid place-items-center">
              <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 12.5 9.5 17.5 19.5 6.5"></path>
              </svg>
            </span>

            <div>
              <h2 class="font-display font-normal text-4xl tracking-tight text-base-content">
                Entregado ✓
              </h2>
              <p class="font-mono text-sm text-base-content/65 mt-1" id="confirm-hora">
                a las --:--
              </p>
              <p class="text-xs text-base-content/60 mt-1">
                Tu solución quedó en la fila de corrección de {sala.docente}.
              </p>
            </div>

            <div class="w-full text-left bg-base-200/60 p-4 rounded-xl border border-base-300 my-2">
              <dl class="text-xs divide-y divide-base-300">
                <div class="flex justify-between py-2">
                  <dt class="text-base-content/60">Consigna</dt>
                  <dd class="font-semibold text-base-content">{consigna.titulo}</dd>
                </div>
                <div class="flex justify-between py-2">
                  <dt class="text-base-content/60">Intento</dt>
                  <dd class="font-mono font-bold text-base-content">{consigna.intentosUsados + 1} de {consigna.intentosMax}</dd>
                </div>
                <div class="flex justify-between py-2">
                  <dt class="text-base-content/60">Sandbox</dt>
                  <dd class="text-base-content/80">apagado automáticamente</dd>
                </div>
                <div class="flex justify-between py-2">
                  <dt class="text-base-content/60">Estado</dt>
                  <dd><span class="badge badge-warning badge-soft font-semibold text-[10px] uppercase tracking-wider">En corrección</span></dd>
                </div>
              </dl>
            </div>

            <a href={`/consignas/?sala=${sala.codigo.toLowerCase()}`} class="btn btn-primary rounded-xl w-full font-semibold">
              Volver a las consignas de la sala
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script is:inline>
    (() => {
      const $ = (sel) => document.querySelector(sel);

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer = null;
      function aviso(msg) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2800);
      }

      // Modal consigna
      const modalConsigna = $('#modal-consigna');
      $('#btn-abrir-consigna')?.addEventListener('click', () => {
        modalConsigna?.showModal();
      });

      // Stepper
      const steps = document.querySelectorAll('#wizard-stepper .step');
      function setStepper(n) {
        steps.forEach((s, idx) => {
          if (idx < n) {
            s.classList.add('step-primary');
          } else {
            s.classList.remove('step-primary');
          }
        });
      }

      // Archivos y dropzone
      const dropzone = $('#dropzone');
      const inputArchivos = $('#f-archivos');
      const listaArchivos = $('#lista-archivos');

      if (dropzone && inputArchivos) {
        ['dragenter', 'dragover'].forEach((ev) => {
          dropzone.addEventListener(ev, (e) => {
            e.preventDefault();
            dropzone.classList.add('border-primary', 'bg-primary/10');
          });
        });
        ['dragleave', 'drop'].forEach((ev) => {
          dropzone.addEventListener(ev, (e) => {
            e.preventDefault();
            dropzone.classList.remove('border-primary', 'bg-primary/10');
          });
        });
        dropzone.addEventListener('drop', (e) => {
          if (e.dataTransfer?.files.length) {
            aviso('Archivo agregado a la entrega.');
          }
        });
        inputArchivos.addEventListener('change', () => {
          if (inputArchivos.files?.length) {
            aviso(inputArchivos.files.length === 1 ? 'Archivo agregado a la entrega.' : 'Archivos agregados a la entrega.');
            inputArchivos.value = '';
          }
        });
      }

      // Quitar archivos
      if (listaArchivos) {
        listaArchivos.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-quitar-archivo');
          if (!btn) return;
          const item = btn.closest('.archivo-item');
          const nombre = item?.dataset.nombre || 'archivo';
          item?.remove();
          aviso(`Quitaste ${nombre} de la entrega.`);
        });
      }

      // Selección de Entorno
      let lenguajeSeleccionado = 'Python';
      const inputPaquetes = $('#f-paquetes');
      const resumenEntorno = $('#resumen-entorno');
      const termRuntime = $('#term-runtime');

      document.querySelectorAll('.leng-chip').forEach((chip) => {
        chip.addEventListener('click', function () {
          document.querySelectorAll('.leng-chip').forEach((c) => {
            c.classList.remove('btn-primary');
            c.classList.add('btn-outline');
            c.setAttribute('aria-pressed', 'false');
          });
          this.classList.remove('btn-outline');
          this.classList.add('btn-primary');
          this.setAttribute('aria-pressed', 'true');
          lenguajeSeleccionado = this.dataset.leng || 'Python';
          if (termRuntime) termRuntime.textContent = `${lenguajeSeleccionado.toLowerCase()} 3.12`;
        });
      });

      function textoEntorno() {
        const paq = inputPaquetes?.value.trim();
        return `${lenguajeSeleccionado} · ${paq ? `paquetes: ${paq}` : 'sin paquetes extra'}`;
      }

      // Navegación entre pasos
      const pasoArchivos = $('#paso-archivos');
      const navPaso2 = $('#nav-paso-2');
      const pasoFinal = $('#paso-final');
      const pasoConfirmado = $('#paso-confirmado');

      $('#btn-continuar-paso3')?.addEventListener('click', () => {
        if (resumenEntorno) resumenEntorno.textContent = textoEntorno();
        pasoArchivos.hidden = true;
        navPaso2.hidden = true;
        pasoFinal.hidden = false;
        setStepper(3);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      $('#btn-volver-editar')?.addEventListener('click', () => {
        pasoFinal.hidden = true;
        pasoArchivos.hidden = false;
        navPaso2.hidden = false;
        setStepper(2);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Probar en Sandbox
      const btnProbar = $('#btn-probar');
      const estadoPrueba = $('#estado-prueba');
      btnProbar?.addEventListener('click', () => {
        if (estadoPrueba) estadoPrueba.style.display = 'none';
        aviso('Corriendo pruebas en el sandbox efímero…');
        setTimeout(() => {
          if (estadoPrueba) estadoPrueba.style.display = '';
          aviso('Prueba exitosa: 4 de 4 casos pasaron.');
        }, 900);
      });

      // Checkpoint de confirmación
      const zonaEntrega = $('#zona-entrega');
      const checkpoint = $('#checkpoint-entrega');

      $('#btn-entregar')?.addEventListener('click', () => {
        zonaEntrega.hidden = true;
        checkpoint.hidden = false;
        $('#btn-confirmar-entrega')?.focus();
      });

      $('#btn-cancelar-checkpoint')?.addEventListener('click', () => {
        checkpoint.hidden = true;
        zonaEntrega.hidden = false;
        $('#btn-entregar')?.focus();
      });

      $('#btn-confirmar-entrega')?.addEventListener('click', () => {
        const d = new Date();
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        const confirmHora = $('#confirm-hora');
        if (confirmHora) confirmHora.textContent = `a las ${hh}:${mm}`;

        pasoArchivos.hidden = true;
        pasoFinal.hidden = true;
        pasoConfirmado.hidden = false;
        setStepper(3);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        aviso('¡Entrega enviada exitosamente!');
      });
    })();
  </script>
</Layout>
