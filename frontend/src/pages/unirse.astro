---
import Layout from '../layouts/Layout.astro';
import { salas } from '../data/mock';
---

<Layout titulo="Unirse a una sala" active="">
  <section class="min-h-[62vh] grid place-items-center py-12">
    <div class="card w-full max-w-xl bg-base-100 border border-base-300 shadow-xl">
      <div class="card-body items-center text-center py-10 px-6 sm:px-10">
        <h1 class="font-display font-normal text-4xl tracking-tight">Unirse a una sala</h1>
        <p class="text-base-content/60">Pedile el código al profe y entrá directo.</p>

        <form class="w-full max-w-sm mt-5 flex flex-col gap-3" action="#" method="get">
          <input
            type="text"
            name="codigo"
            maxlength="7"
            placeholder="PROG5A"
            aria-label="Código de sala"
            autocomplete="off"
            spellcheck="false"
            class="input input-bordered h-16 w-full text-center font-mono text-2xl font-semibold tracking-[0.18em] uppercase bg-base-200 border-2 border-base-300 rounded-2xl focus:border-primary focus:bg-base-100 focus:outline-none placeholder:text-base-content/40"
          />
          <button type="submit" class="btn btn-primary btn-lg rounded-full">Entrar a la sala</button>
        </form>

        <p class="mt-4 text-xs text-base-content/60 flex items-center gap-2 flex-wrap justify-center">
          Ejemplos:
          {salas.map((s) => (
            <span class="badge badge-outline font-mono text-[11px] tracking-widest">{s.codigo}</span>
          ))}
        </p>
        <p class="mt-2 text-xs text-base-content/60 leading-relaxed max-w-xs">
          Tu alias es anónimo dentro de la sala (ej.: Alumno-PROG5A-07). Nadie ve tu nombre real.
        </p>
      </div>
    </div>
  </section>
</Layout>
