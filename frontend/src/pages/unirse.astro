---
import Layout from '../layouts/Layout.astro';
import { salas } from '../data/mock';
---

<Layout titulo="Ingresar con código" active="unirse" navRole="anonimo">
  <section class="min-h-[62vh] grid place-items-center py-10 sm:py-16">
    <div class="card w-full max-w-xl bg-base-100 border border-base-300 shadow-xl">
      <div class="card-body items-center text-center py-10 px-6 sm:px-10">
        <span class="badge badge-primary badge-soft font-mono text-xs font-semibold px-3 py-1 mb-1">
          Acceso rápido
        </span>
        <h1 class="font-display font-normal text-3xl sm:text-4xl tracking-tight text-base-content">
          Ingresar con código
        </h1>
        <p class="text-sm text-base-content/70 max-w-sm">
          Escribí el código que te pasó tu docente para sumarte al aula o el código de tu escuela.
        </p>

        <form id="form-unirse" class="w-full max-w-sm mt-5 flex flex-col gap-3" novalidate>
          <input
            id="input-codigo"
            type="text"
            name="codigo"
            maxlength="8"
            placeholder="PROG5A"
            aria-label="Código del aula o escuela"
            autocomplete="off"
            spellcheck="false"
            class="input input-bordered h-16 w-full text-center font-mono text-2xl font-bold tracking-[0.18em] uppercase bg-base-200/60 border-2 border-base-300 rounded-2xl focus:border-primary focus:bg-base-100 focus:outline-none placeholder:text-base-content/30"
          />
          <button type="submit" class="btn btn-primary btn-lg rounded-2xl font-semibold shadow-xs">
            Entrar al aula
          </button>
        </form>

        <p class="mt-4 text-xs text-base-content/60 flex items-center gap-2 flex-wrap justify-center">
          Ejemplos:
          {salas.map((s) => (
            <button type="button" class="badge badge-outline font-mono text-[11px] tracking-widest hover:border-primary cursor-pointer btn-ejemplo" data-cod={s.codigo}>
              {s.codigo}
            </button>
          ))}
        </p>
        <p class="mt-2 text-xs text-base-content/60 leading-relaxed max-w-xs">
          Tu alias es anónimo dentro del aula (ej.: Alumno-PROG5A-07). Nadie ve tu nombre real salvo tu docente.
        </p>
      </div>
    </div>
  </section>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script is:inline>
    (() => {
      const $ = (sel) => document.querySelector(sel);
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer = null;
      function aviso(msg) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2600);
      }

      const input = $('#input-codigo');
      input?.addEventListener('input', function () {
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
      });

      document.querySelectorAll('.btn-ejemplo').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cod = btn.dataset.cod;
          if (input && cod) input.value = cod;
        });
      });

      $('#form-unirse')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const cod = input?.value.trim();
        if (!cod) {
          input?.focus();
          aviso('Ingresá el código provisto por tu docente.');
          return;
        }
        aviso(`Ingresando al aula «${cod}»…`);
        setTimeout(() => {
          window.location.href = '/mis-salas/';
        }, 700);
      });
    })();
  </script>
</Layout>

