---
import Layout from '../layouts/Layout.astro';
import { consignas, salas } from '../data/mock';

const sala = salas[0]; // Programación 5.º A
const totalConsignas = consignas.length;
const totalRecibidas = consignas.reduce((acc, c) => acc + c.stats.recibidas, 0);
const totalEsperadas = consignas.reduce((acc, c) => acc + c.stats.total, 0);
const totalOk = consignas.reduce((acc, c) => acc + c.stats.ok, 0);
---

<Layout titulo={`Consignas — ${sala.nombre}`} active="consignas" navRole="docente">
  <div class="py-6 sm:py-10 space-y-6">

    <!-- Hero Header del Aula -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-2">
      <div>
        <a
          href="/dashboard/"
          class="inline-flex items-center gap-1.5 text-xs text-base-content/60 hover:text-primary transition-colors font-medium mb-2.5"
        >
          ← Mis Aulas
        </a>
        <p class="font-mono text-xs font-bold uppercase tracking-widest text-primary">
          {sala.nombre} · {sala.curso} · {sala.turno}
        </p>
        <h1 class="font-display font-normal text-3xl sm:text-4xl md:text-5xl tracking-tight text-base-content mt-1">
          Consignas
        </h1>
        <p class="text-sm text-base-content/70 mt-1">
          {totalConsignas} consignas publicadas · {totalRecibidas} de {totalEsperadas} entregas recibidas · {totalOk} correctas.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 shrink-0">
        <div class="flex items-center gap-2 p-1 bg-base-100 rounded-2xl border border-base-300 shadow-xs">
          <span class="badge badge-lg bg-primary/10 border-0 text-primary font-mono font-bold tracking-wider rounded-xl px-3 text-sm">
            {sala.codigo}
          </span>
          <button
            type="button"
            id="btn-copiar-codigo"
            data-codigo={sala.codigo}
            class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold hover:text-primary"
            aria-label="Copiar código de la sala"
          >
            Copiar
          </button>
        </div>

        <a
          href="/consigna-nueva/"
          class="btn btn-primary btn-sm md:btn-md rounded-xl font-semibold shadow-xs"
        >
          + Nueva consigna
        </a>
      </div>
    </section>

    <!-- Sub-navegación dentro del aula (Consignas / Alumnos / Configuración) -->
    <nav class="flex gap-1.5 overflow-x-auto pb-1 border-b border-base-300 text-sm font-medium" aria-label="Secciones del aula">
      <a
        href="/consignas/"
        class="px-4 py-2 rounded-xl bg-primary text-primary-content font-semibold"
        aria-current="page"
      >
        Consignas ({totalConsignas})
      </a>
      <a
        href="/alumnos/"
        class="px-4 py-2 rounded-xl text-base-content/70 hover:bg-base-300 hover:text-base-content transition-colors"
      >
        Alumnos (28)
      </a>
      <a
        href="/sala-config/"
        class="px-4 py-2 rounded-xl text-base-content/70 hover:bg-base-300 hover:text-base-content transition-colors"
      >
        Configuración
      </a>
    </nav>

    <!-- Lista de Consignas -->
    <section aria-labelledby="titulo-lista" class="space-y-4 pt-2">
      <h2 class="sr-only" id="titulo-lista">Listado de consignas</h2>

      <div class="flex flex-col divide-y divide-base-300 bg-base-100 rounded-2xl border border-base-300 overflow-hidden shadow-xs">
        {consignas.map((c) => {
          const porcOk = Math.round((c.stats.ok / c.stats.total) * 100);
          const porcErr = Math.round((c.stats.error / c.stats.total) * 100);
          const porcTar = Math.round((c.stats.tardia / c.stats.total) * 100);

          return (
            <article class="p-5 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-5 hover:bg-base-200/40 transition-colors">

              <!-- Columna Principal -->
              <div class="flex-1 min-w-0 flex flex-col gap-2.5">
                <div class="flex items-center gap-3 flex-wrap">
                  <h3 class="font-display font-normal text-2xl tracking-tight text-base-content">
                    <a href={`/entregas/${c.id}/`} class="hover:text-primary transition-colors">
                      {c.titulo}
                    </a>
                  </h3>
                  <span class="badge badge-sm badge-outline font-mono text-[10px] uppercase font-bold tracking-wider text-base-content/70">
                    {c.runtime}
                  </span>
                  {c.sinLimite && (
                    <span class="badge badge-sm badge-ghost font-medium text-[10px]">
                      Sin fecha límite
                    </span>
                  )}
                </div>

                <p class:list={[
                  'text-xs',
                  c.vencida ? 'text-error font-semibold' : 'text-base-content/65'
                ]}>
                  {c.vence} {c.vencida && '· podés seguir corrigiendo'}
                </p>

                <!-- Barra de progreso segmentada -->
                <div
                  class="flex h-2 max-w-md w-full rounded-full overflow-hidden bg-base-200 border border-base-300"
                  role="progressbar"
                  aria-label={`${c.stats.ok} OK, ${c.stats.error} error, ${c.stats.tardia} tardía de ${c.stats.recibidas} entregas`}
                >
                  <div class="bg-primary h-full" style={`width: ${porcOk}%`}></div>
                  <div class="bg-error h-full" style={`width: ${porcErr}%`}></div>
                  <div class="bg-warning h-full" style={`width: ${porcTar}%`}></div>
                </div>

                <!-- Desglose de estados -->
                <ul class="flex items-center gap-4 flex-wrap text-xs text-base-content/70 font-medium">
                  <li class="inline-flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-primary inline-block"></span>
                    {c.stats.ok} OK
                  </li>
                  <li class="inline-flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-error inline-block"></span>
                    {c.stats.error} con error
                  </li>
                  <li class="inline-flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-warning inline-block"></span>
                    {c.stats.tardia} tardía
                  </li>
                  <li class="text-base-content/50">
                    {c.stats.sinEntregar} sin entregar
                  </li>
                </ul>
              </div>

              <!-- Columna Lateral / Acción -->
              <div class="flex md:flex-col items-center md:items-end justify-between md:justify-center gap-2 shrink-0 pt-3 md:pt-0 border-t md:border-t-0 border-base-200">
                <div class="text-left md:text-right">
                  <span class="font-mono font-bold text-xl text-base-content block leading-none">
                    {c.stats.recibidas}<span class="text-base-content/40 text-sm font-normal">/{c.stats.total}</span>
                  </span>
                  <span class="text-[10px] uppercase font-bold tracking-widest text-base-content/50 block mt-0.5">
                    entregas
                  </span>
                </div>

                <a
                  href={`/entregas/${c.id}/`}
                  class="btn btn-ghost btn-sm text-primary hover:bg-primary/10 font-semibold px-3 underline underline-offset-4"
                >
                  Ver entregas
                </a>
              </div>

            </article>
          );
        })}
      </div>
    </section>

  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-5 py-2.5 text-sm font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script is:inline>
    (() => {
      const $ = (sel) => document.querySelector(sel);

      // Toast feedback
      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer = null;
      function aviso(msg) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2600);
      }

      // Copiar código de sala
      const btnCopiar = $('#btn-copiar-codigo');
      btnCopiar?.addEventListener('click', function () {
        const codigo = this.dataset.codigo || 'PROG5A';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(codigo).then(
            () => aviso(`Código «${codigo}» copiado al portapapeles.`),
            () => aviso(`El código es «${codigo}»`)
          );
        } else {
          aviso(`El código es «${codigo}»`);
        }
      });
    })();
  </script>
</Layout>
