---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Vincular PC · Ocicat Móvil (PWA)" hideNav={true} navRole="alumno">
  <div class="min-h-dvh flex justify-center py-0 sm:py-6 bg-base-200">

    <!-- Shell Móvil (<420px) -->
    <div class="w-full max-w-[420px] min-h-dvh sm:min-h-[780px] bg-base-100 sm:border sm:border-base-300 sm:rounded-3xl shadow-xl flex flex-col overflow-hidden">

      <!-- PWA Status Bar Mock -->
      <div class="flex justify-between items-center px-5 pt-3 pb-1 text-[11px] font-mono font-semibold text-base-content/60 bg-base-200/50">
        <span>14:35</span>
        <div class="flex items-center gap-1.5">
          <span>4G</span>
          <span>🔋 88%</span>
        </div>
      </div>

      <!-- PWA Header -->
      <header class="flex items-center justify-between px-5 py-3 border-b border-base-300 bg-base-100">
        <a href="/mis-salas/" class="flex items-center gap-2 text-base-content no-underline">
          <span class="grid place-items-center size-7 rounded-lg bg-primary text-primary-content shadow-xs">
            <svg width="18" height="18" viewBox="0 0 36 36" aria-hidden="true" class="fill-current">
              <path d="M8 15 9.2 4.5 15.5 10Z" opacity=".8" />
              <path d="M28 15 26.8 4.5 20.5 10Z" opacity=".8" />
              <circle cx="18" cy="21" r="11.5" fill="var(--color-base-100)" />
              <circle cx="11" cy="17.5" r="1.7" fill="var(--color-primary)" opacity=".85" />
              <circle cx="24" cy="24" r="2" fill="var(--color-primary)" opacity=".85" />
              <circle cx="19.5" cy="29" r="1.3" fill="var(--color-primary)" opacity=".7" />
              <circle cx="14" cy="19.5" r="1.7" fill="var(--color-base-100)" />
              <circle cx="22" cy="19.5" r="1.7" fill="var(--color-base-100)" />
              <path d="M16.7 23.6h2.6L18 25.6Z" fill="var(--color-primary)" />
            </svg>
          </span>
          <span class="font-display text-base tracking-tight font-normal">
            Ocicat <em class="italic text-primary">móvil</em>
          </span>
        </a>

        <label class="swap swap-rotate btn btn-ghost btn-xs btn-circle" aria-label="Cambiar tema">
          <input type="checkbox" class="theme-controller" value="ocicat-dark" />
          <svg class="swap-off size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/></svg>
          <svg class="swap-on size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </label>
      </header>

      <!-- Barra de Usuario Logueado en Celular -->
      <div class="flex items-center justify-between px-5 py-3 bg-base-200/60 border-b border-base-300">
        <div class="flex items-center gap-2.5">
          <div class="avatar placeholder">
            <div class="bg-primary text-primary-content rounded-full w-8 font-bold text-xs">
              <span id="u-iniciales">··</span>
            </div>
          </div>
          <div class="text-left leading-tight">
            <strong class="text-xs font-bold text-base-content block" id="u-nombre">Cargando…</strong>
            <span class="text-[10px] text-base-content/60" id="u-escuela"></span>
          </div>
        </div>
        <span class="badge badge-primary badge-soft font-mono text-[10px] font-bold px-2 py-0.5">
          PWA Alumno
        </span>
      </div>

      <!-- Contenido Principal PWA -->
      <div class="flex-1 p-4 flex flex-col gap-4 overflow-y-auto">

        <!-- Card de Confirmación QR (estado manejado por JS) -->
        <div class="card bg-base-100 border-2 border-primary shadow-md p-4 flex flex-col gap-3 relative" id="card-confirmacion">
          <p class="flex items-center gap-2 text-sm text-base-content/70">
            <span class="loading loading-spinner loading-sm text-primary"></span>
            Cargando…
          </p>
        </div>

      </div>

      <!-- Barra de Navegación Inferior PWA -->
      <nav class="flex justify-around items-center px-2 py-2 border-t border-base-300 bg-base-100 mt-auto">
        <a href="/mis-salas/" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-base-content/60 hover:text-primary">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          <span>Aulas</span>
        </a>
        <a href="/materiales/" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-base-content/60 hover:text-primary">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Materiales</span>
        </a>
        <a href="/pwa-pair/" class="flex flex-col items-center gap-0.5 text-[10px] font-bold text-primary">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Escanear PC</span>
        </a>
        <a href="/perfil/" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-base-content/60 hover:text-primary">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Mi Perfil</span>
        </a>
      </nav>

    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast toast-bottom toast-center z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite">
    <div class="alert alert-neutral shadow-lg rounded-full px-4 py-2 text-xs font-medium">
      <span id="toast-msg">Notificación</span>
    </div>
  </div>

  <script>
    import { ApiError, me, qrScan, qrConfirm, qrDeny, type ScanInfo } from '../lib/api';

    (() => {
      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T | null;

      const toast = $('#toast');
      const toastMsg = $('#toast-msg');
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function aviso(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer ?? undefined);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 2600);
      }

      const card = $('#card-confirmacion');

      // El qr_url del contrato apunta a /qr/{token} en el dominio oficial.
      // El backend debe servir esta página ahí (o con ?token=); aceptamos ambos.
      function tokenDeURL(): string {
        const qs = new URLSearchParams(window.location.search).get('token');
        if (qs) return qs.trim();
        const m = window.location.pathname.match(/\/qr\/([A-Za-z0-9_-]+)\/?$/);
        return m ? m[1] : '';
      }

      function esc(input: string): string {
        const div = document.createElement('div');
        div.textContent = input;
        return div.innerHTML;
      }

      function cuando(ts: string): string {
        const d = new Date(ts);
        return Number.isNaN(d.getTime())
          ? ts
          : d.toLocaleString('es-AR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
      }

      function htmlFormulario(mensaje?: string): string {
        return `
          ${mensaje ? `<p class="text-xs text-error font-medium">${esc(mensaje)}</p>` : ''}
          <p class="text-xs text-base-content/70 leading-relaxed">
            Escaneá con la cámara del celu el QR que muestra la PC, o pegá acá el token que aparece debajo del código.
          </p>
          <form id="form-token" class="flex gap-2">
            <input
              type="text"
              id="in-token"
              required
              autocomplete="off"
              spellcheck="false"
              placeholder="Token del QR"
              class="input input-bordered input-sm w-full rounded-xl font-mono text-xs bg-base-200/60 focus:bg-base-100 focus:border-primary"
            />
            <button type="submit" class="btn btn-primary btn-sm rounded-xl text-xs font-semibold shrink-0">
              Conectar
            </button>
          </form>`;
      }

      function pintarInicial(mensaje?: string) {
        if (!card) return;
        card.className = 'card bg-base-100 border border-base-300 shadow-md p-4 flex flex-col gap-3';
        card.innerHTML = `
          <div class="flex items-center gap-2 text-sm font-bold text-base-content">
            <svg class="size-4.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Vincular una PC</span>
          </div>
          ${htmlFormulario(mensaje)}
        `;
        engancharFormulario();
      }

      // [C3]: device_label es decorativo; origin_ip + requested_at son la prueba real
      function pintarConfirmacion(info: ScanInfo) {
        if (!card) return;
        const label = info.device_label || 'esta PC';
        card.className = 'card bg-base-100 border-2 border-primary shadow-md p-4 flex flex-col gap-3 relative';
        card.innerHTML = `
          <div class="flex items-center gap-2 text-sm font-bold text-base-content">
            <svg class="size-4.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span>¿Conectar con <span class="font-mono">${esc(label)}</span>?</span>
          </div>

          <p class="text-xs text-base-content/70">
            Se solicitó inicio de sesión desde este equipo. Verificá los datos antes de confirmar.
          </p>

          <div class="bg-base-200 rounded-xl p-3 flex flex-col gap-1.5 text-xs">
            <div class="flex justify-between items-center">
              <span class="text-base-content/60">Equipo:</span>
              <span class="font-mono font-bold text-base-content">${esc(label)}</span>
            </div>
            ${info.origin_ip ? `
            <div class="flex justify-between items-center">
              <span class="text-base-content/60">IP de origen:</span>
              <span class="font-mono font-bold text-base-content">${esc(info.origin_ip)}</span>
            </div>` : ''}
            <div class="flex justify-between items-center">
              <span class="text-base-content/60">Solicitado:</span>
              <span class="font-semibold text-base-content/80">${esc(cuando(info.requested_at))}</span>
            </div>
          </div>

          <div class="flex flex-col gap-2 mt-1">
            <button class="btn btn-primary rounded-xl w-full text-xs font-semibold" type="button" id="btn-confirmar-pair">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Sí, conectar ahora en la PC
            </button>
            <button class="btn btn-ghost btn-xs text-error font-medium hover:bg-error/10 py-2 h-auto" type="button" id="btn-rechazar-pair">
              No soy yo / Rechazar
            </button>
          </div>
        `;
        $('#btn-confirmar-pair')?.addEventListener('click', () => void confirmar(info.pairing_id, label));
        $('#btn-rechazar-pair')?.addEventListener('click', () => void rechazar(info.pairing_id));
      }

      function pintarExito(label: string) {
        if (!card) return;
        card.className = 'card bg-success/10 border-2 border-success p-4 flex flex-col gap-2 text-center';
        card.innerHTML = `
          <div class="text-2xl mb-0.5">✨</div>
          <strong class="text-sm font-bold text-success">¡Sesión iniciada en ${esc(label)}!</strong>
          <p class="text-xs text-base-content/70">Ya podés usar esa computadora con tu usuario. La sesión es temporal y expira sola.</p>
        `;
      }

      function pintarRechazado() {
        if (!card) return;
        card.className = 'card bg-base-100 border border-base-300 shadow-md p-4 flex flex-col gap-3 text-center';
        card.innerHTML = `
          <strong class="text-sm font-bold text-base-content">Conexión rechazada.</strong>
          <p class="text-xs text-base-content/70">La PC no iniciará sesión. Podés ingresar otro código si querés volver a intentar.</p>
          ${htmlFormulario()}
        `;
        engancharFormulario();
      }

      function ocuparBotones() {
        const b1 = $('#btn-confirmar-pair') as HTMLButtonElement | null;
        const b2 = $('#btn-rechazar-pair') as HTMLButtonElement | null;
        [b1, b2].forEach((b) => {
          if (!b) return;
          b.setAttribute('disabled', '');
          b.classList.add('loading');
        });
      }

      async function escanear(token: string) {
        try {
          const info = await qrScan(token);
          pintarConfirmacion(info);
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          if (err instanceof ApiError && err.status === 410) {
            pintarInicial('Ese código ya expiró. Mirá el nuevo QR en la pantalla de la PC.');
            return;
          }
          pintarInicial(err instanceof ApiError ? err.message : 'No pudimos validar el código.');
        }
      }

      async function confirmar(pairingId: string, label: string) {
        ocuparBotones();
        try {
          await qrConfirm(pairingId);
          aviso(`¡Conexión con ${label} confirmada con éxito!`);
          pintarExito(label);
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          const msg =
            err instanceof ApiError && err.status === 410
              ? 'El código venció antes de confirmar. Escaneá el nuevo QR.'
              : err instanceof ApiError
                ? err.message
                : 'No pudimos confirmar la conexión.';
          aviso(msg);
          pintarInicial(msg);
        }
      }

      async function rechazar(pairingId: string) {
        ocuparBotones();
        try {
          await qrDeny(pairingId);
          aviso('Conexión rechazada. La PC seguirá esperando.');
          pintarRechazado();
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
            return;
          }
          aviso(err instanceof ApiError ? err.message : 'No pudimos rechazar la conexión.');
          pintarInicial();
        }
      }

      function engancharFormulario() {
        $('#form-token')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const input = $('#in-token') as HTMLInputElement | null;
          const token = input?.value.trim() ?? '';
          if (!token) {
            aviso('Pegá el token que muestra la PC.');
            input?.focus();
            return;
          }
          if (!card) return;
          card.querySelector('form')?.remove();
          card.insertAdjacentHTML(
            'beforeend',
            '<p class="flex items-center gap-2 text-sm text-base-content/70"><span class="loading loading-spinner loading-sm text-primary"></span>Validando código…</p>',
          );
          void escanear(token);
        });
      }

      // Usuario real en la barra superior
      async function cargarUsuario() {
        try {
          const user = await me();
          const iniciales = $('#u-iniciales');
          const nombre = $('#u-nombre');
          const escuela = $('#u-escuela');
          if (nombre) nombre.textContent = user.name;
          if (escuela) escuela.textContent = user.school_name ?? '';
          if (iniciales) {
            const partes = user.name.split(' ').filter(Boolean);
            iniciales.textContent =
              partes.length >= 2 ? (partes[0][0] + partes[1][0]).toUpperCase() : user.name.slice(0, 2).toUpperCase();
          }
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.href = '/login/';
          }
        }
      }

      void cargarUsuario();

      const tokenURL = tokenDeURL();
      if (tokenURL) {
        void escanear(tokenURL);
      } else {
        pintarInicial();
      }
    })();
  </script>
</Layout>
