---
import '../styles/global.css';
import { usuariosMock, type Rol } from '../data/mock';

interface Props {
  titulo: string;
  active?: 'inicio' | 'materiales' | 'sandboxes' | 'aulas' | 'mis-aulas' | 'consignas' | 'perfil' | 'login' | 'entregas' | 'admin' | 'setup' | string;
  navRole?: Rol | 'public';
  hideNav?: boolean;
  badgeCount?: number;
}

const {
  titulo,
  active = '',
  navRole = 'anonimo',
  hideNav = false,
  badgeCount,
} = Astro.props;

const effectiveRole: Rol = navRole === 'public' ? 'anonimo' : navRole;
const user = usuariosMock[effectiveRole] || usuariosMock.docente;
const notifications = badgeCount !== undefined ? badgeCount : user.notificacionesCount;

// Definición de enlaces por rol según CASOS-USO.md y nav-estados.html
interface NavLinkItem {
  href: string;
  label: string;
  key: string;
}

let navLinks: NavLinkItem[] = [];

if (effectiveRole === 'anonimo') {
  navLinks = [
    { href: '/materiales/', label: 'Materiales públicos', key: 'materiales' },
    { href: '/sandboxes/', label: 'Proyectos', key: 'sandboxes' },
  ];
} else if (effectiveRole === 'invitado') {
  navLinks = [
    { href: '/materiales/', label: 'Materiales', key: 'materiales' },
    { href: '/sandboxes/', label: 'Proyectos', key: 'sandboxes' },
  ];
} else if (effectiveRole === 'alumno') {
  navLinks = [
    { href: '/mis-salas/', label: 'Mis Aulas', key: 'aulas' },
    { href: '/consignas/', label: 'Mis Entregas', key: 'consignas' },
    { href: '/materiales/', label: 'Materiales', key: 'materiales' },
    { href: '/sandboxes/', label: 'Proyectos', key: 'sandboxes' },
  ];
} else if (effectiveRole === 'docente') {
  navLinks = [
    { href: '/dashboard/', label: 'Aulas', key: 'aulas' },
    { href: '/consignas/', label: 'Consignas', key: 'consignas' },
    { href: '/materiales/', label: 'Materiales', key: 'materiales' },
    { href: '/sandboxes/', label: 'Proyectos', key: 'sandboxes' },
  ];
} else if (effectiveRole === 'director') {
  navLinks = [
    { href: '/escuela/', label: 'Gestión Escolar', key: 'escuela' },
    { href: '/dashboard/', label: 'Aulas', key: 'aulas' },
    { href: '/consignas/', label: 'Consignas', key: 'consignas' },
    { href: '/materiales/', label: 'Materiales', key: 'materiales' },
    { href: '/sandboxes/', label: 'Proyectos', key: 'sandboxes' },
  ];
}
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Materiales y sandboxes para escuelas. FOSS, auto-hospedado, ligero." />
    <title>{titulo} — Ocicat Bella</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh flex flex-col font-sans text-base-content antialiased bg-base-200">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn btn-primary btn-sm">
      Ir al contenido
    </a>

    <header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-300">
      <div class="navbar h-16 max-w-[1180px] mx-auto px-4 sm:px-7">
        <!-- Izquierda: Mobile toggle + Brand + Badges -->
        <div class="navbar-start gap-2 max-w-[65%] sm:max-w-none">
          {!hideNav && (
            <div class="dropdown md:hidden">
              <div tabindex="0" role="button" class="btn btn-ghost btn-square btn-sm" aria-label="Abrir menú">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </div>
              <ul tabindex="0" class="dropdown-content menu z-50 mt-2 w-60 rounded-box bg-base-100 border border-base-300 shadow-xl p-2">
                <li class="menu-title text-xs text-base-content/60 uppercase">Navegación ({effectiveRole})</li>
                {navLinks.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class={active === l.key ? 'active font-semibold' : ''}
                      aria-current={active === l.key ? 'page' : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
                <li class="divider my-1"></li>
                {effectiveRole === 'anonimo' && (
                  <>
                    <li><a href="/unirse/">Ingresar con código</a></li>
                    <li><a href="/login/" class="font-medium text-primary">Iniciar sesión</a></li>
                  </>
                )}
                {effectiveRole === 'invitado' && (
                  <li><a href="/login/">Tengo cuenta / Iniciar sesión</a></li>
                )}
                {(effectiveRole === 'alumno' || effectiveRole === 'docente' || effectiveRole === 'director') && (
                  <>
                    <li><a href="/perfil/">Mi Perfil ({user.nombre})</a></li>
                    <li><a href="/pair/">Conectar PC por QR</a></li>
                    <li><a href="/login/" class="text-error">Cerrar sesión</a></li>
                  </>
                )}
              </ul>
            </div>
          )}

          <a href="/" class="flex items-center gap-2.5 min-w-0" aria-label="Ocicat Bella — Inicio">
            <span class="grid place-items-center size-9 rounded-[10px] bg-primary shrink-0 text-primary-content shadow-sm">
              <svg width="22" height="22" viewBox="0 0 36 36" aria-hidden="true" class="fill-current">
                <path d="M8 15 9.2 4.5 15.5 10Z" opacity=".8" />
                <path d="M28 15 26.8 4.5 20.5 10Z" opacity=".8" />
                <circle cx="18" cy="21" r="11.5" fill="var(--color-base-100)" />
                <circle cx="11" cy="17.5" r="1.7" fill="var(--color-primary)" opacity=".85" />
                <circle cx="24" cy="24" r="2" fill="var(--color-primary)" opacity=".85" />
                <circle cx="19.5" cy="29" r="1.3" fill="var(--color-primary)" opacity=".7" />
                <circle cx="14" cy="19.5" r="1.7" fill="var(--color-base-100)" />
                <circle cx="22" cy="19.5" r="1.7" fill="var(--color-base-100)" />
                <path d="M16.7 23.6h2.6L18 25.6Z" fill="var(--color-primary)" />
              </svg>
            </span>
            <span class="font-display text-lg leading-tight tracking-tight whitespace-nowrap">
              Ocicat <em class="italic text-primary font-normal">bella</em>
            </span>
          </a>

          {effectiveRole === 'invitado' && (
            <span class="hidden sm:inline-flex badge badge-warning badge-soft font-mono text-xs font-semibold px-2.5 py-1 rounded-full">
              Invitado · E.E.S.T. N° 1
            </span>
          )}
        </div>

        <!-- Centro: Enlaces principales desktop -->
        {!hideNav && (
          <div class="navbar-center hidden md:flex">
            <ul class="menu menu-horizontal gap-1 px-1">
              {navLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={active === l.key ? 'page' : undefined}
                    class:list={[
                      'rounded-full text-sm font-medium transition-colors px-3.5 py-1.5',
                      active === l.key
                        ? 'bg-neutral text-neutral-content font-semibold'
                        : 'text-base-content/75 hover:bg-base-300 hover:text-base-content',
                    ]}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Derecha: Acciones por rol, notificaciones, perfil y tema -->
        <div class="navbar-end gap-2 shrink-0">
          <!-- Toggle Tema Claro/Oscuro -->
          <label class="swap swap-rotate btn btn-ghost btn-sm md:btn-md btn-circle" aria-label="Cambiar tema claro u oscuro">
            <input type="checkbox" class="theme-controller" value="ocicat-dark" />
            <svg class="swap-off size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/></svg>
            <svg class="swap-on size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </label>

          {effectiveRole === 'anonimo' && (
            <div class="flex items-center gap-2">
              <a href="/unirse/" class="btn btn-outline btn-primary btn-sm md:btn-md rounded-full font-medium">
                <span class="md:hidden">Código</span>
                <span class="hidden md:inline">Ingresar con código</span>
              </a>
              <a href="/login/" class="btn btn-primary btn-sm md:btn-md rounded-full font-medium">
                Iniciar sesión
              </a>
              <a href="/login/" class="btn btn-ghost btn-sm md:btn-md rounded-full font-medium text-base-content/70">
                Soy alumno (email escolar)
              </a>
            </div>
          )}

          {effectiveRole === 'invitado' && (
            <a href="/login/" class="btn btn-outline btn-sm md:btn-md rounded-full font-medium text-xs md:text-sm">
              <span class="sm:hidden">Acceso</span>
              <span class="hidden sm:inline">Tengo cuenta / Iniciar sesión</span>
            </a>
          )}

          {(effectiveRole === 'alumno' || effectiveRole === 'docente' || effectiveRole === 'director') && (
            <div class="flex items-center gap-2">
              {/* Badge servidor si es director */}
              {effectiveRole === 'director' && (
                <span class="hidden lg:inline-flex badge badge-success badge-soft font-mono text-xs font-semibold py-1">
                  ● Servidor OK
                </span>
              )}

              <!-- Campana de notificaciones con badge interactivo -->
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm md:btn-md relative" aria-label={`Ver ${notifications} notificaciones`}>
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                  </svg>
                  {notifications > 0 && (
                    <span class="badge badge-xs badge-error absolute top-1 right-1 text-[10px] font-bold text-error-content px-1">
                      {notifications}
                    </span>
                  )}
                </div>
                <div tabindex="0" class="dropdown-content z-50 card card-compact w-72 p-3 shadow-xl bg-base-100 border border-base-300">
                  <div class="card-body">
                    <div class="flex justify-between items-center border-b border-base-200 pb-2">
                      <span class="font-bold text-sm">Notificaciones</span>
                      <span class="badge badge-sm badge-primary">{notifications} nuevas</span>
                    </div>
                    <ul class="space-y-2 text-xs py-1">
                      {effectiveRole === 'alumno' ? (
                        <>
                          <li class="p-1.5 rounded-lg bg-base-200/60">
                            <strong>TP2 Manejo de archivos</strong>
                            <p class="text-base-content/70">Vence este viernes 28 de agosto</p>
                          </li>
                          <li class="p-1.5 rounded-lg bg-base-200/60">
                            <strong>Kata de funciones</strong>
                            <p class="text-base-content/70">Devolución: ¡Aprobado con observaciones!</p>
                          </li>
                        </>
                      ) : effectiveRole === 'docente' ? (
                        <>
                          <li class="p-1.5 rounded-lg bg-base-200/60">
                            <strong>5 nuevas entregas</strong>
                            <p class="text-base-content/70">Programación 5.º A · TP2</p>
                          </li>
                          <li class="p-1.5 rounded-lg bg-base-200/60">
                            <strong>2 consultas en Base de Datos</strong>
                            <p class="text-base-content/70">Mateo G. y Valentina C.</p>
                          </li>
                        </>
                      ) : (
                        <li class="p-1.5 rounded-lg bg-base-200/60">
                          <strong>Backup semanal completado</strong>
                          <p class="text-base-content/70">Servidor escolar en óptimo estado</p>
                        </li>
                      )}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Menú de Usuario / Perfil -->
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost p-1 sm:px-2.5 h-auto flex items-center gap-2 rounded-xl border border-base-300 hover:border-primary/40 bg-base-100">
                  <div class="avatar placeholder">
                    <div class="bg-primary text-primary-content rounded-full w-7 sm:w-8 font-bold text-xs">
                      <span>{user.iniciales}</span>
                    </div>
                  </div>
                  <div class="hidden sm:flex flex-col text-left leading-tight">
                    <span class="text-xs font-semibold">{user.nombre.split(' ')[0]} {user.nombre.split(' ')[1]?.[0]}.</span>
                    <span class="text-[10px] text-base-content/60 font-mono">{user.subtitulo}</span>
                  </div>
                </div>
                <ul tabindex="0" class="dropdown-content menu z-50 mt-2 w-56 rounded-box bg-base-100 border border-base-300 shadow-xl p-2">
                  <li class="menu-title px-2 py-1 text-xs">
                    <span class="font-bold text-base-content">{user.nombre}</span>
                    <span class="text-[11px] text-base-content/60 font-normal">{user.email || user.subtitulo}</span>
                  </li>
                  <li class="divider my-1"></li>
                  <li><a href="/perfil/">Mi Perfil y Sesiones</a></li>
                  <li><a href="/pair/">Conectar PC de laboratorio</a></li>
                  {effectiveRole === 'docente' && (
                    <li><a href="/dashboard/">Mis Aulas ({user.subtitulo})</a></li>
                  )}
                  {effectiveRole === 'director' && (
                    <>
                      <li><a href="/escuela/">Gestión de la Escuela</a></li>
                      <li><a href="/dashboard/">Todas las Aulas</a></li>
                    </>
                  )}
                  <li class="divider my-1"></li>
                  <li><a href="/login/" class="text-error font-medium">Cerrar sesión</a></li>
                </ul>
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Banner de Impersonación Administrativa (§9.5) -->
    <div
      id="banner-impersonacion"
      hidden
      class="sticky top-0 z-[60] bg-warning text-warning-content px-4 py-2 text-xs sm:text-sm font-medium border-b border-warning-content/20 shadow-md"
      role="alert"
    >
      <div class="max-w-[1180px] mx-auto flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="badge badge-sm badge-neutral font-mono font-bold">ADMIN</span>
          <span>
            Estás viendo la plataforma como <strong id="imp-usuario-nombre">…</strong> (<span id="imp-usuario-rol">…</span>) · <em class="not-italic opacity-80">Sesión impersonada</em>
          </span>
        </div>
        <button
          type="button"
          id="btn-salir-impersonacion"
          class="btn btn-neutral btn-xs rounded-lg font-bold shadow-xs hover:bg-neutral-focus"
        >
          Volver a mi sesión de director
        </button>
      </div>
    </div>

    <main id="contenido" class="flex-1 w-full max-w-[1180px] mx-auto px-4 sm:px-7">
      <slot />
    </main>

    <footer class="mt-16 border-t border-base-300 bg-base-100">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-7 py-8 flex flex-wrap justify-between items-center gap-4 text-sm text-base-content/70">
        <div class="flex items-center gap-3">
          <span class="font-semibold text-base-content">Ocicat Bella</span>
          <span>·</span>
          <span>Software libre (FOSS) para escuelas</span>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono">
          <a href="/pair/" class="hover:underline text-primary font-medium">Login QR PC</a>
          <span>·</span>
          <a href="/login/" class="hover:underline">Acceso</a>
          <span>·</span>
          <span>v0.2-mvp</span>
        </div>
      </div>
    </footer>
  </body>
  <script is:inline>
    // Persistencia de tema — corre antes del paint para evitar flash
    (() => {
      const saved = localStorage.getItem('ocicat-theme');
      if (saved) document.documentElement.dataset.theme = saved;
      const isDark = () => (document.documentElement.dataset.theme || '') === 'ocicat-dark'
        || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => document.querySelectorAll('.theme-controller').forEach((el) => { el.checked = isDark(); });
      sync();
      document.querySelectorAll('.theme-controller').forEach((el) => {
        el.addEventListener('change', () => {
          const t = el.checked ? 'ocicat-dark' : 'ocicat';
          document.documentElement.dataset.theme = t;
          localStorage.setItem('ocicat-theme', t);
        });
      });
    })();
  </script>
  <script>
    import { me, stopImpersonation } from '../lib/api';

    (async () => {
      try {
        const yo = await me();
        if (yo.impersonated_by) {
          const banner = document.getElementById('banner-impersonacion');
          const nombre = document.getElementById('imp-usuario-nombre');
          const rol = document.getElementById('imp-usuario-rol');
          if (nombre) nombre.textContent = yo.name;
          if (rol) rol.textContent = yo.role;
          if (banner) banner.hidden = false;

          document.getElementById('btn-salir-impersonacion')?.addEventListener('click', async () => {
            const btn = document.getElementById('btn-salir-impersonacion') as HTMLButtonElement | null;
            if (btn) {
              btn.disabled = true;
              btn.textContent = 'Volviendo…';
            }
            try {
              await stopImpersonation();
              window.location.href = '/escuela/';
            } catch {
              window.location.reload();
            }
          });
        }
      } catch {
        // no logueado o error de red
      }
    })();
  </script>
</html>
